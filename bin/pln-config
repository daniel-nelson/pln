#!/usr/bin/env bash
# pln-config — read/write ~/.pln/config.yaml
#
# Usage:
#   pln-config get <key>          — read a config value (whole value, spaces and
#                                   all, so a key can hold a full command line)
#   pln-config set <key> <value>  — write a config value
#   pln-config list               — show all config
#
# Env overrides (for testing):
#   PLN_STATE_DIR  — override ~/.pln state directory
set -euo pipefail

STATE_DIR="${PLN_STATE_DIR:-$HOME/.pln}"
CONFIG_FILE="$STATE_DIR/config.yaml"

case "${1:-}" in
  get)
    KEY="${2:?Usage: pln-config get <key>}"
    # Return the whole value as written, not just its first token: a value may
    # be a full command line. Strips the `KEY:` prefix and surrounding spaces.
    VALUE="$(grep -E "^${KEY}:" "$CONFIG_FILE" 2>/dev/null | tail -1 \
      | sed -E "s/^${KEY}:[[:space:]]*//; s/[[:space:]]+\$//" || true)"
    if [ -z "$VALUE" ] && [ "$KEY" = "evidence_profile" ]; then
      VALUE="inherit"
    fi
    printf '%s\n' "$VALUE"
    ;;
  set)
    KEY="${2:?Usage: pln-config set <key> <value>}"
    VALUE="${3:?Usage: pln-config set <key> <value>}"
    if [ "$KEY" = "evidence_profile" ]; then
      case "$VALUE" in
        inherit | economy) ;;
        *) echo "pln-config: evidence_profile must be inherit or economy" >&2; exit 2 ;;
      esac
    fi
    if [ "$KEY" = "peer_egress" ]; then
      case "$VALUE" in
        consent | approved-only) ;;
        *) echo "pln-config: peer_egress must be consent or approved-only" >&2; exit 2 ;;
      esac
    fi
    mkdir -p "$STATE_DIR"
    if grep -qE "^${KEY}:" "$CONFIG_FILE" 2>/dev/null; then
      # Portable in-place rewrite (avoids BSD vs GNU `sed -i` divergence)
      grep -v -E "^${KEY}:" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" 2>/dev/null || true
      echo "${KEY}: ${VALUE}" >> "$CONFIG_FILE.tmp"
      mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
    else
      echo "${KEY}: ${VALUE}" >> "$CONFIG_FILE"
    fi
    ;;
  list)
    if ! grep -q '^evidence_profile:' "$CONFIG_FILE" 2>/dev/null; then
      echo 'evidence_profile: inherit'
    fi
    if ! grep -q '^peer_egress:' "$CONFIG_FILE" 2>/dev/null; then
      echo 'peer_egress: unset'
    fi
    cat "$CONFIG_FILE" 2>/dev/null || true
    ;;
  *)
    echo "Usage: pln-config {get|set|list} [key] [value]"
    exit 1
    ;;
esac
