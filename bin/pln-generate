#!/usr/bin/env bash
# pln-generate — build the host-specific skill files from the sources in src/.
#
# Every skill file that says anything host-specific is generated, not tracked.
# The tracked sources are:
#
#   src/<path>.core.md      the host-neutral body, with directives (below)
#   src/hosts/<host>/*.md   the per-host fragments the directives pull in
#   src/hosts/<host>/vars   literal KEY=value substitutions
#   src/shared/*.md         fragments with one text for both hosts, so a passage
#                           shared by two skills lives in one file
#
# and each `src/<path>.core.md` generates `<path>.md` at the repo root. So
# `src/SKILL.core.md` → `SKILL.md`, `src/pln-pr/SKILL.core.md` → `pln-pr/SKILL.md`.
#
# The point is that by the time a model reads a skill, text addressed to the
# other host is absent — not present-but-ignored. Nothing asks the model to skip
# the wrong branch or to remember to read a companion file.
#
# Directives (deliberately three, all one line; this is not a template language):
#
#   <!-- pln:include NAME -->    replaced by src/hosts/<host>/NAME.md, or by
#                                src/shared/NAME.md when the host has no such
#                                fragment (host wins wherever both exist)
#   <!-- pln:only <host> -->     ... <!-- pln:endonly -->   kept for that host only
#   {{KEY}}                      replaced by KEY's value from the host's vars file
#
# Usage:
#   pln-generate <host>              generate every target for <host>
#   pln-generate --list              print the generated target paths, one per line
#   pln-generate --clean             restore every target to its committed stub
#   pln-generate --host <host> --out-dir <dir>
#                                    generate into <dir> instead of the repo root
#
# Exits non-zero on a missing fragment or a malformed directive, without leaving
# a half-written target behind.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SRC_DIR="$REPO_DIR/src"
OUT_DIR="$REPO_DIR"
HOST=""
MODE="generate"

usage() {
  cat >&2 <<'USAGE'
Usage:
  pln-generate <host>                          generate every target for <host> (claude|codex)
  pln-generate --list                          print the generated target paths
  pln-generate --clean                         restore every target to its committed stub
  pln-generate --host <host> --out-dir <dir>   generate into <dir> instead of the repo root
USAGE
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --list) MODE="list"; shift ;;
    --clean) MODE="clean"; shift ;;
    --host) HOST="${2:-}"; shift 2 ;;
    --out-dir) OUT_DIR="${2:-}"; shift 2 ;;
    -h | --help) usage ;;
    -*) echo "pln-generate: unknown option '$1'" >&2; usage ;;
    *) HOST="$1"; shift ;;
  esac
done

[ -d "$SRC_DIR" ] || { echo "pln-generate: no src/ directory at $SRC_DIR" >&2; exit 1; }

# Target list: src/<path>.core.md → <path>.md, sorted for stable output.
list_targets() {
  find "$SRC_DIR" -type f -name '*.core.md' | LC_ALL=C sort | while IFS= read -r core; do
    rel="${core#"$SRC_DIR"/}"
    printf '%s\n' "${rel%.core.md}.md"
  done
}

if [ "$MODE" = "list" ]; then
  list_targets
  exit 0
fi

# --clean: put the generated files back to what git has, so an upgrade
# (which stashes then hard-resets) never sees a modified tracked file.
if [ "$MODE" = "clean" ]; then
  if [ ! -d "$REPO_DIR/.git" ]; then
    echo "pln-generate: --clean needs a git checkout; nothing to restore" >&2
    exit 0
  fi
  while IFS= read -r target; do
    git -C "$REPO_DIR" checkout -- "$target" 2>/dev/null || true
  done < <(list_targets)
  exit 0
fi

case "$HOST" in
  claude | codex) ;;
  "") echo "pln-generate: a host is required" >&2; usage ;;
  *) echo "pln-generate: unknown host '$HOST' (expected claude or codex)" >&2; exit 1 ;;
esac

FRAG_DIR="$SRC_DIR/hosts/$HOST"
SHARED_DIR="$SRC_DIR/shared"
VARS_FILE="$FRAG_DIR/vars"
[ -d "$FRAG_DIR" ] || { echo "pln-generate: no fragments for host '$HOST' at $FRAG_DIR" >&2; exit 1; }
[ -f "$VARS_FILE" ] || VARS_FILE=/dev/null

render() {
  # render <core-file> <host> — writes the rendered document to stdout.
  awk \
    -v host="$2" \
    -v fragdir="$FRAG_DIR" \
    -v shareddir="$SHARED_DIR" \
    -v varsfile="$VARS_FILE" \
    -v banner="<!-- Generated by bin/pln-generate for the $2 host — do not edit.\n     Edit src/ and run ./setup instead. -->" \
    '
    function die(msg) {
      printf("pln-generate: %s\n", msg) > "/dev/stderr"
      exit_code = 1
      exit 1
    }
    function subst(line,   k) {
      for (k in V) gsub("\\{\\{" k "\\}\\}", V[k], line)
      return line
    }
    # Emit a line, slipping the generated-by banner in just after the YAML
    # frontmatter (it has to stay the first thing in the file for skill loaders).
    function emit(l) {
      print l
      if (banner_done) return
      if (NR == 1 && l == "---") { in_fm = 1; return }
      if (in_fm && l == "---") { print banner; banner_done = 1 }
    }
    function directive_arg(line, kind,   s) {
      s = line
      sub("^<!--[[:space:]]*pln:" kind "[[:space:]]+", "", s)
      sub("[[:space:]]*-->[[:space:]]*$", "", s)
      if (s == "" || s ~ /[[:space:]]/) die("malformed pln:" kind " at line " NR ": " line)
      return s
    }
    BEGIN {
      while ((getline vline < varsfile) > 0) {
        if (vline ~ /^[[:space:]]*#/ || vline ~ /^[[:space:]]*$/) continue
        eq = index(vline, "=")
        if (eq == 0) continue
        vkey = substr(vline, 1, eq - 1)
        vval = substr(vline, eq + 1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", vkey)
        gsub(/&/, "\\\\&", vval)   # & is the whole-match backreference in gsub
        V[vkey] = vval
      }
      close(varsfile)
    }
    /^<!--[[:space:]]*pln:only[[:space:]]/ {
      if (in_only) die("nested pln:only at line " NR)
      in_only = 1
      skip = (directive_arg($0, "only") != host)
      next
    }
    /^<!--[[:space:]]*pln:endonly[[:space:]]*-->/ {
      if (!in_only) die("pln:endonly without pln:only at line " NR)
      in_only = 0
      skip = 0
      next
    }
    skip { next }
    /^<!--[[:space:]]*pln:include[[:space:]]/ {
      name = directive_arg($0, "include")
      # A per-host fragment wins; src/shared/ is the fallback, for text that is
      # one and the same on both hosts. (No apostrophes in here: the whole awk
      # program is one single-quoted shell string.)
      path = fragdir "/" name ".md"
      r = (getline fline < path)
      if (r < 0) {
        close(path)
        path = shareddir "/" name ".md"
        r = (getline fline < path)
        if (r < 0) die("missing fragment " name ".md at line " NR ": not in " fragdir " and not in " shareddir)
      }
      while (r > 0) {
        if (fline ~ /pln:include/) die("nested pln:include inside " path)
        emit(subst(fline))
        r = (getline fline < path)
      }
      close(path)
      next
    }
    { emit(subst($0)) }
    END {
      if (exit_code) exit 1
      if (in_only) die("unclosed pln:only block")
      if (!banner_done) die("no YAML frontmatter found — nowhere to stamp the generated-by banner")
    }
    ' "$1"
}

count=0
while IFS= read -r target; do
  core="$SRC_DIR/${target%.md}.core.md"
  out="$OUT_DIR/$target"
  mkdir -p "$(dirname "$out")"
  tmp="$(mktemp "${TMPDIR:-/tmp}/pln-generate.XXXXXX")"
  if ! render "$core" "$HOST" > "$tmp"; then
    rm -f "$tmp"
    echo "pln-generate: failed generating $target for $HOST — left it untouched" >&2
    exit 1
  fi
  cat "$tmp" > "$out"
  rm -f "$tmp"
  count=$((count + 1))
done < <(list_targets)

echo "pln-generate: wrote $count skill file(s) for the $HOST host"
