#!/usr/bin/env bash
# pln-routing-rule — add the /pln-pr routing rule to the agent's global instructions.
#
# When present, this rule tells the agent to route every "open/create/put up a PR"
# request (including ones embedded in a larger instruction like "bump the version
# and open the PR") through the /pln-pr skill instead of pushing and running
# `gh pr create` directly. It exists because trigger phrasing alone doesn't
# reliably route a compound imperative to the skill.
#
# Usage:
#   pln-routing-rule --plan      — preview the change; never writes
#   pln-routing-rule --apply     — apply the change (idempotent)
#   pln-routing-rule --offer     — emit the one-time offer if not yet prompted
#   pln-routing-rule --remove    — delete the routing block (idempotent)
#
# An explicit mode is required. Any other argument (including --help, a typo, or
# no argument at all) prints usage and exits non-zero WITHOUT writing anything.
#
# Prints one machine-readable line: RESULT: <result>
#   already-present  — the rule is already installed; nothing to do
#   plan:add         — (--plan only) the rule would be added
#   added            — (--apply only) the rule was appended
#   offer            — (--offer only) the offer was emitted
#   skip             — (--offer only) already prompted / present / no target
#   removed          — (--remove only) the routing block was deleted
#   not-present      — (--remove only) no routing block found; nothing to do
#   no-target        — no global-instructions dir found; nothing written
#
# Target and wording both follow the host this copy is installed under, derived
# from the install path by bin/pln-host (each host gets its own clone):
#
#   claude → $HOME/.claude/CLAUDE.md      — routes via the Skill tool
#   codex  → ${CODEX_HOME:-$HOME/.codex}/AGENTS.md — names the skill instead
#
# If the host's global dir does not exist, RESULT: no-target and nothing is
# written. Override the target with PLN_ROUTING_TARGET and the host with
# PLN_HOST for testing.
#
# The Codex block is deliberately terse: Codex inlines AGENTS.md in full on
# every invocation (and truncates it at 32 KB), so this text is paid for on
# every turn.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

MODE="${1:-}"
case "$MODE" in
  --plan|--apply|--offer|--remove) ;;
  *)
    cat >&2 <<'USAGE'
Usage: pln-routing-rule <mode>
  --plan    preview the /pln-pr routing rule; never writes
  --apply   append the routing rule to the host's global instructions (idempotent)
  --offer   emit the one-time offer if not yet prompted
  --remove  delete the routing rule from the host's global instructions (idempotent)
An explicit mode is required; no other argument writes anything.
USAGE
    exit 2
    ;;
esac

# Which host is this copy installed under? The install path answers it, so
# there is nothing to ask and nothing for the host to cooperate on.
HOST="$("$SELF_DIR/pln-host" 2>/dev/null || echo claude)"
case "$HOST" in
  claude | codex) ;;
  *) HOST="claude" ;;
esac

# Resolve the target global-instructions file for that host.
TARGET="${PLN_ROUTING_TARGET:-}"
if [ -z "$TARGET" ]; then
  case "$HOST" in
    codex)
      # Codex reads $CODEX_HOME/AGENTS.md into every prompt (verified against
      # `codex debug prompt-input`).
      _CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
      if [ -d "$_CODEX_HOME" ]; then
        TARGET="$_CODEX_HOME/AGENTS.md"
      fi
      ;;
    *)
      if [ -d "$HOME/.claude" ]; then
        TARGET="$HOME/.claude/CLAUDE.md"
      fi
      ;;
  esac
fi

MARKER="<!-- pln-pr-routing -->"
END_MARKER="<!-- /pln-pr-routing -->"

# The rule text is host-specific: Claude Code routes through the Skill tool,
# Codex has no such tool and picks skills up by name.
if [ "$HOST" = "codex" ]; then
read -r -d '' BLOCK <<'EOF' || true
<!-- pln-pr-routing -->
## PR routing

When the user asks to open, create, put up, or "ship" a pull request — including as one clause of a longer instruction like "bump the version and open the PR" — use the `pln-pr` skill rather than pushing and running `gh pr create` / `glab mr create` yourself. It reviews the branch, fixes what it finds, verifies once, then opens the PR. Honor an explicit "skip the review".
<!-- /pln-pr-routing -->
EOF
else
read -r -d '' BLOCK <<'EOF' || true
<!-- pln-pr-routing -->
## PR routing

When the user asks to open, create, put up, or "ship" a pull request — including when the request is embedded in a larger instruction like "bump the version and open the PR" or "push this up" — route through the `/pln-pr` skill (invoke it via the Skill tool). Do not push and run `gh pr create` / `glab mr create` directly. `/pln-pr` runs a fresh-context review army, fixes what it finds, verifies once, and opens the PR. Honor an explicit "skip the review" if the user says so.
<!-- /pln-pr-routing -->
EOF
fi

# --- helpers -----------------------------------------------------------------

# has_target: a writable global-instructions location is resolvable.
has_target() {
  [ -n "$TARGET" ] && [ -d "$(dirname "$TARGET")" ]
}

# rule_present: the marker is already in the target file.
rule_present() {
  [ -f "$TARGET" ] && grep -qF "$MARKER" "$TARGET" 2>/dev/null
}

emit_plan() {
  echo "Would append to: $TARGET"
  echo "----"
  printf '%s\n' "$BLOCK"
  echo "----"
}

# --- --offer -----------------------------------------------------------------
# Centralized offer + gate. setup and /pln-update relay this instead of
# reimplementing the check. Emits the agent-directed offer block followed by the
# --plan preview when the offer should fire; otherwise RESULT: skip.
if [ "$MODE" = "--offer" ]; then
  PROMPTED="$("$SELF_DIR/pln-config" get routing_prompted 2>/dev/null || true)"

  if [ "$PROMPTED" = "true" ] || rule_present || ! has_target; then
    echo "RESULT: skip"
    exit 0
  fi

  echo "=== OPTIONAL (agent: ask the user before doing anything) ==="
  echo "/pln-pr works best when PR requests route through it. A compound"
  echo "instruction like \"bump the version and open the PR\" can otherwise"
  echo "bypass the review army. I can add a short routing rule to the user's"
  echo "global instructions (preview below) so those requests route to /pln-pr."
  echo ""
  emit_plan
  echo ""
  echo "AGENT: ask the user whether to add this rule."
  echo "  - On YES: run  $SELF_DIR/pln-routing-rule --apply"
  echo "            then  $SELF_DIR/pln-config set routing_prompted true"
  echo "  - On NO:  run  $SELF_DIR/pln-config set routing_prompted true"
  echo "=== END OPTIONAL ==="
  echo "RESULT: offer"
  exit 0
fi

# --- --remove ----------------------------------------------------------------
# Delete the marker-delimited routing block from the target. Idempotent: if the
# block isn't present (including no target file), RESULT: not-present.
if [ "$MODE" = "--remove" ]; then
  if ! rule_present; then
    echo "RESULT: not-present"
    exit 0
  fi
  TMP="$(mktemp "${TMPDIR:-/tmp}/pln-routing.XXXXXX")"
  # Delete the start-marker line through the end-marker line inclusive, and drop
  # a single blank line immediately preceding the block (the append separator).
  awk -v start="$MARKER" -v end="$END_MARKER" '
    in_block { if (index($0, end)) in_block=0; next }
    index($0, start) { in_block=1; pending=0; next }
    /^$/ { pending=1; next }
    { if (pending) { print ""; pending=0 } print }
    END { if (pending) print "" }
  ' "$TARGET" > "$TMP"
  cat "$TMP" > "$TARGET"
  rm -f "$TMP"
  echo "RESULT: removed"
  exit 0
fi

# --- --plan / --apply --------------------------------------------------------

if ! has_target; then
  echo "RESULT: no-target"
  exit 0
fi

if rule_present; then
  echo "RESULT: already-present"
  exit 0
fi

if [ "$MODE" = "--plan" ]; then
  emit_plan
  echo "RESULT: plan:add"
  exit 0
fi

# --apply: append with a blank-line separator. Create the file if absent.
if [ -f "$TARGET" ] && [ -s "$TARGET" ]; then
  # Ensure the file ends in a newline so the blank-line separator always holds.
  if [ -n "$(tail -c 1 "$TARGET")" ]; then
    printf '\n' >> "$TARGET"
  fi
  printf '\n%s\n' "$BLOCK" >> "$TARGET"
else
  printf '%s\n' "$BLOCK" >> "$TARGET"
fi
echo "RESULT: added"
