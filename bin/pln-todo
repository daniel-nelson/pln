#!/usr/bin/env bash
# pln-todo — the follow-up to-do list: resolve where it lives, file into it, read it
# back, and move records out of it. Host-neutral: bash and git, no network and no
# agent CLI. There is no delete subcommand — a record is archived, never destroyed.
set -euo pipefail

INDEX_NAME='TO-DO.md'
LIVE_DIR='items'
DONE_DIR='archive'
# The names this store was written under before 1.59.0. They survive in exactly
# one place — the recognition probe inside root resolution, which decides between
# migrating, refusing a root that holds two lists, and creating a new one. Past
# that decision nothing downstream names an old name.
OLD_INDEX_NAME='QUEUE.md'
OLD_LIVE_DIR='q'
OLD_DONE_DIR='done'
# A format version rather than a printed string, so it is not renamed: it is what
# `pln-scheduler` and `pln-simplify` identify a to-do-list root by, and what
# `header_field` requires on the first line of every store already on disk.
HEADER_OPEN='<!-- pln-queue v1'
HEADER_CLOSE='-->'
DECLARED_KEY='pln-todo'
# The declaration users have already written into their own instruction files.
# Renaming the key would invalidate data pln does not own, so the old one keeps
# working; two declarations that disagree fail closed rather than picking one.
OLD_DECLARED_KEY='pln-queue'

fail() { echo "pln-todo: $*" >&2; exit 2; }
refuse() { echo "pln-todo: $*" >&2; exit 3; }

usage() {
  cat >&2 <<'EOF'
Usage:
  pln-todo init [--project DIR] [--root PATH] [--answered] [--migration-offered]
  pln-todo add --id ID --claim TEXT --source TEXT [--status ready|blocked|decide|dropped]
               [--state "[ ]"|"[-]"|"[x]"] [--urgent] [--group TEXT] [--opened YYYY-MM-DD]
               [--depends-on CSV] [--touches CSV] [--holds CSV] [--body FILE|-]
  pln-todo list [--project DIR]
  pln-todo check --id ID [--against CSV] [--run TEXT]
  pln-todo claim --id ID --run TEXT [--touches CSV] [--holds CSV]
                 [--against CSV] [--steal HOLDER]
  pln-todo mark --id ID [--run TEXT] [--state S] [--status S] [--urgent true|false] [--group TEXT]
                [--touches CSV] [--holds CSV] [--depends-on CSV] [--source TEXT]
                [--add-sub-item TEXT] [--sub-item-state "[ ]"|"[-]"|"[x]"]
  pln-todo archive --id ID --disposition completed|dropped|superseded|resolved-elsewhere
                   --evidence TEXT [--month YYYY-MM]
  pln-todo stale [--days N]

Global options: [--project DIR] [--no-create]

There is no delete subcommand: a record is archived, never destroyed.

Exit codes: 0 done, 2 usage or failure, 3 refused (a collision, an occupied path,
no resolvable to-do list). Every subcommand resolves the to-do list first and reports
TODO_ROOT, whether it created one, and whether the location question is owed.

Env overrides (for testing):
  PLN_TODO_DATE — the UTC date the helper writes (YYYY-MM-DD)
EOF
  exit 2
}

# ---------------------------------------------------------------- small helpers

today() {
  local d="${PLN_TODO_DATE:-}"
  [ -n "$d" ] || d="$(date -u '+%Y-%m-%d')"
  case "$d" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) fail "date must be YYYY-MM-DD: $d" ;;
  esac
  printf '%s\n' "$d"
}

ymd_epoch() {
  if date -u -j -f '%Y-%m-%d' "$1" '+%s' >/dev/null 2>&1; then
    date -u -j -f '%Y-%m-%d' "$1" '+%s'
  else
    date -u -d "$1" '+%s'
  fi
}

epoch_ymd() {
  if date -u -r "$1" '+%Y-%m-%d' 2>/dev/null; then return 0; fi
  date -u -d "@$1" '+%Y-%m-%d'
}

# The date N days before $1. ISO dates compare correctly as strings, so the
# cutoff is all the staleness pass needs and no arithmetic happens per item.
cutoff_date() {
  local base days epoch
  base="$1"; days="$2"
  epoch="$(ymd_epoch "$base" 2>/dev/null)" || { printf '%s\n' "$base"; return 0; }
  epoch_ymd "$(( epoch - days * 86400 ))"
}

# Resolve git facts from the directory itself, never from an ambient GIT_DIR: an
# exported GIT_DIR with the working directory elsewhere makes --is-inside-work-tree
# true while the work tree and the common dir name two different repositories.
# Discovering both from the same clean resolution makes that disagreement
# impossible rather than detected after the fact.
git_clean() {
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE \
      -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES git "$@"
}

abs_dir() { (cd "$1" && pwd -P); }

single_line() {
  case "$2" in *$'\n'* | *$'\r'* | *$'\t'*) fail "$1 must be single-line and tab-free" ;; esac
}

valid_id() {
  case "$1" in
    '' | *[!a-z0-9-]* | -* | *-) return 1 ;;
    *) return 0 ;;
  esac
}

valid_state() {
  case "$1" in '[ ]' | '[-]' | '[x]') return 0 ;; *) return 1 ;; esac
}

valid_status() {
  case "$1" in ready | blocked | decide | dropped) return 0 ;; *) return 1 ;; esac
}

csv_to_lines() {
  printf '%s' "$1" | tr ',' '\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^$' || true
}

lines_to_yaml_list() {
  local out='' item
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    if [ -z "$out" ]; then out="$item"; else out="$out, $item"; fi
  done
  printf '[%s]' "$out"
}

# ------------------------------------------------------------------- resolution

PROJECT_DIR=''
PROJECT_TOP=''
COMMON_DIR=''
IN_WORKTREE=0
IS_BARE=0
TODO_ROOT=''
RESOLVED_BY=''
CREATED=0
NOTES=()
SET_ANSWERED=''
SET_OFFERED=''
# `list`, `check` and `stale` are reads to whoever calls them, and a read of the
# to-do list never fails. They are the three that fall back to reading an
# unmigratable store in place rather than refusing it.
READ_ONLY_CMD=0

note() { NOTES+=("$1"); }

project_context() {
  scan_project_context "$1"
  check_declarations
}

scan_project_context() {
  PROJECT_DIR="$(abs_dir "$1")" || fail "project directory does not exist: $1"
  PROJECT_TOP="$PROJECT_DIR"
  COMMON_DIR=''
  IN_WORKTREE=0
  IS_BARE=0
  local inside top common bare
  bare="$(git_clean -C "$PROJECT_DIR" rev-parse --is-bare-repository 2>/dev/null || true)"
  [ "$bare" != "true" ] || IS_BARE=1
  inside="$(git_clean -C "$PROJECT_DIR" rev-parse --is-inside-work-tree 2>/dev/null || true)"
  [ "$inside" = "true" ] || return 0
  top="$(git_clean -C "$PROJECT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$top" ] || [ ! -d "$top" ]; then return 0; fi
  IN_WORKTREE=1
  PROJECT_TOP="$(abs_dir "$top")"
  common="$(git_clean -C "$PROJECT_TOP" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [ -n "$common" ] && [ -d "$common" ] && [ ! -L "$common" ]; then
    COMMON_DIR="$(abs_dir "$common")"
  fi
  return 0
}

is_gitlink() {
  # $1 = repo top, $2 = path relative to it
  [ "$IN_WORKTREE" = 1 ] || return 1
  local mode
  mode="$(git_clean -C "$1" ls-files --stage -- "$2" 2>/dev/null | awk 'NR==1 {print $1}')"
  [ "$mode" = "160000" ]
}

# Empty, or holding nothing but $2 — the file a project's instructions named,
# which the derived root is allowed to contain and which is never touched.
dir_is_empty() {
  local n
  if [ -n "${2:-}" ]; then
    n="$(ls -A "$1" 2>/dev/null | LC_ALL=C grep -v -x -F -- "$2" | LC_ALL=C grep -c '' || true)"
  else
    n="$(ls -A "$1" 2>/dev/null | LC_ALL=C grep -c '' || true)"
  fi
  [ "${n:-0}" = "0" ]
}

# The recognition probe, and the one place an old name is read. A helper that
# knew only the new index name would decline a store written before 1.59.0 as
# "something other than a to-do list", refuse at the project-root leg and create
# a second list at the common-dir leg — so recognition answers to either name and
# the migration below is what removes the old one.
has_index() { [ -f "$1/$2" ] && [ ! -L "$1/$2" ]; }

looks_like_todo() {
  if has_index "$1" "$INDEX_NAME"; then return 0; fi
  if has_index "$1" "$OLD_INDEX_NAME"; then return 0; fi
  dir_is_empty "$1" "${2:-}"
}

# Adopt an existing candidate root, or say why it was passed over — a name
# collision in someone else's repository must not make pln write into a
# directory that belongs to something else.
# $1 candidate path, $2 leg name, $3 name for the gitlink probe (or ''),
# $4 a filename inside it that does not count against emptiness (or '')
adopt_candidate() {
  local cand="$1" leg="$2" rel="${3:-}" spare="${4:-}"
  if [ ! -e "$cand" ] && [ ! -L "$cand" ]; then return 1; fi
  if [ -L "$cand" ]; then
    note "$leg: $cand is a symlink, not adopted"
    return 1
  fi
  if [ ! -d "$cand" ]; then
    note "$leg: $cand is not a directory, not adopted"
    return 1
  fi
  if [ -n "$rel" ] && is_gitlink "$PROJECT_TOP" "$rel"; then
    note "$leg: $cand is a git submodule mountpoint, not adopted"
    return 1
  fi
  if ! looks_like_todo "$cand" "$spare"; then
    note "$leg: $cand holds something other than a to-do list, not adopted"
    return 1
  fi
  TODO_ROOT="$(abs_dir "$cand")"
  RESOLVED_BY="$leg"
  return 0
}

# The instruction-file leg is a read of prose everywhere else; what a bash helper
# can recognize deterministically is the one-line declaration pln tells the user
# to write:  pln-todo: <path>
# One key, scanned across both instruction files in that order. Prints
# "<file>\t<path>", or nothing.
declared_for_key() {
  local key="$1" file path
  for file in "$PROJECT_TOP/CLAUDE.md" "$PROJECT_TOP/AGENTS.md"; do
    [ -f "$file" ] || continue
    path="$(LC_ALL=C sed -n -E \
      "s/^[[:space:]]*(-[[:space:]]+)?\`?${key}:\`?[[:space:]]+\`?([^\`]+)\`?[[:space:]]*\$/\\2/p" \
      "$file" 2>/dev/null | head -1 || true)"
    path="$(printf '%s' "$path" | sed -e 's/[[:space:]]*$//')"
    if [ -n "$path" ]; then printf '%s\t%s\n' "$file" "$path"; return 0; fi
  done
  return 1
}

# A declared path made absolute, so two declarations are compared as locations
# rather than as the strings someone happened to type.
abs_declared() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    '~/'*) printf '%s\n' "$HOME/${1#\~/}" ;;
    *) printf '%s\n' "$PROJECT_TOP/$1" ;;
  esac
}

# Both keys are read, because `pln-queue: <path>` is a string users have already
# written into their own instruction files and renaming it would invalidate data
# pln does not own. Where both are declared and they name different locations
# this fails closed and says which file holds which, rather than letting a stale
# declaration in one file win quietly over a current one in the other.
declared_path() {
  local new old
  new="$(declared_for_key "$DECLARED_KEY" || true)"
  if [ -n "$new" ]; then printf '%s\n' "$(printf '%s' "$new" | LC_ALL=C cut -f2)"; return 0; fi
  old="$(declared_for_key "$OLD_DECLARED_KEY" || true)"
  if [ -n "$old" ]; then printf '%s\n' "$(printf '%s' "$old" | LC_ALL=C cut -f2)"; return 0; fi
  return 1
}

# Run once, from `project_context`, and never inside a command substitution: a
# refusal raised in a subshell would print and be discarded by the caller's
# `|| true`, which is the shape every `declared_path` call site has.
check_declarations() {
  local new old new_file old_file new_path old_path
  new="$(declared_for_key "$DECLARED_KEY" || true)"
  old="$(declared_for_key "$OLD_DECLARED_KEY" || true)"
  [ -n "$new" ] && [ -n "$old" ] || return 0
  new_file="$(printf '%s' "$new" | LC_ALL=C cut -f1)"
  old_file="$(printf '%s' "$old" | LC_ALL=C cut -f1)"
  new_path="$(abs_declared "$(printf '%s' "$new" | LC_ALL=C cut -f2)")"
  old_path="$(abs_declared "$(printf '%s' "$old" | LC_ALL=C cut -f2)")"
  [ "$new_path" != "$old_path" ] || return 0
  refuse "two to-do-list locations are declared and they disagree: $new_file says \`$DECLARED_KEY: $new_path\` and $old_file says \`$OLD_DECLARED_KEY: $old_path\`; nothing was written until one of them goes"
}

# Refuse the repository top level and any ancestor of it. A project documenting a
# root-level TODO.md would otherwise scatter TO-DO.md, items/ and archive/ across its top
# level unasked, and put pln's own dirt exclusion in front of user-owned changes.
instruction_root_ok() {
  local root="${1%/}"
  [ "$IN_WORKTREE" = 1 ] || return 0
  if [ "$root" = "$PROJECT_TOP" ]; then
    note "instructions: $root is the repository top level, not adopted"
    return 1
  fi
  case "$PROJECT_TOP/" in
    "$root"/*)
      note "instructions: $root contains the repository top level, not adopted"
      return 1
      ;;
  esac
  return 0
}

# One-way, once, on first touch. A store written before 1.59.0 carries the old
# index, live-directory and archive names; this renames them in place and then
# rebuilds the index, after which nothing on disk answers to an old name.
#
# It runs from `create_todo`, ahead of that function's own `mkdir -p` and index
# write, because those run on all five resolution legs and would otherwise put an
# empty new live directory in front of the migration — a bare `mv` would then move
# the old directory *inside* the new one, silently and at exit 0. The explicit leg
# never calls `adopt_candidate`, so hooking the probe into adoption alone would
# miss `pln-todo init --root PATH`, which is the command for adopting a list that
# already exists.
#
# Each rename is individually atomic and the whole thing is resumable: a run
# killed between two of them leaves a root a later run finishes, which is why the
# refusal below is written against two *complete* lists — two index files — and
# not against any old name standing beside any new one.
#
# The lock is taken here, before adoption, because resolution runs ahead of every
# subcommand's own `take_lock` and `check` and `stale` never lock at all. Without
# it two linked worktrees sharing one root can meet inside the rename window, and
# `list` rewrites the index to `_No open items._` over a store whose detail files
# are all still in the old directory.
migrate_store() {
  local root="$1" old new pair present=''
  [ -d "$root" ] && [ ! -L "$root" ] || return 0

  # Only inside something that is already a to-do list, under either name set. The
  # explicit leg adopts a path the user typed with no adoption probe in front of
  # it, and a `done/` or `q/` of theirs in an unrelated directory is not pln's to
  # rename. A run killed after the index rename leaves the new index and the old
  # directories, which is why the new name counts here too: that is the state a
  # later run has to be able to finish.
  has_index "$root" "$OLD_INDEX_NAME" || has_index "$root" "$INDEX_NAME" || return 0

  for pair in "$OLD_INDEX_NAME:$INDEX_NAME" "$OLD_LIVE_DIR:$LIVE_DIR" "$OLD_DONE_DIR:$DONE_DIR"; do
    old="${pair%%:*}"
    if [ -e "$root/$old" ] || [ -L "$root/$old" ]; then present="$present$pair "; fi
  done
  [ -n "$present" ] || return 0

  if has_index "$root" "$INDEX_NAME" && has_index "$root" "$OLD_INDEX_NAME"; then
    report_notes
    refuse "$root holds two to-do lists — one at $root/$INDEX_NAME and an older one at $root/$OLD_INDEX_NAME; nothing was written, and nothing is merged or guessed at: keep one of them"
  fi
  for pair in $present; do
    old="${pair%%:*}"; new="${pair#*:}"
    if [ -e "$root/$new" ] || [ -L "$root/$new" ]; then
      report_notes
      refuse "$root holds both $root/$old and $root/$new; nothing was written, and nothing is merged or guessed at: keep one of them"
    fi
  done

  # A read of the to-do list never fails, so a store on a read-only mount or under
  # an unwritable parent is still read — under its old names, in place, said out
  # loud. Only the subcommands that write refuse, because writing is what cannot
  # be done there at all.
  if [ ! -w "$root" ]; then
    if [ "$READ_ONLY_CMD" = 1 ]; then
      INDEX_NAME="$OLD_INDEX_NAME"; LIVE_DIR="$OLD_LIVE_DIR"; DONE_DIR="$OLD_DONE_DIR"
      note "$root cannot be written, so its older file names were read in place and nothing was migrated"
      return 0
    fi
    report_notes
    refuse "$root still carries the older file names and cannot be written, so it cannot be migrated; nothing was written"
  fi

  TODO_ROOT="$(abs_dir "$root")"
  if ! take_lock "$([ "$READ_ONLY_CMD" = 1 ] && echo 0 || echo 1)"; then
    INDEX_NAME="$OLD_INDEX_NAME"; LIVE_DIR="$OLD_LIVE_DIR"; DONE_DIR="$OLD_DONE_DIR"
    note "$TODO_ROOT is locked by $(lock_owner_desc "$TODO_ROOT/.lock"), so its older file names were read in place and nothing was migrated"
    return 0
  fi
  for pair in $present; do
    old="${pair%%:*}"; new="${pair#*:}"
    [ -e "$TODO_ROOT/$old" ] || [ -L "$TODO_ROOT/$old" ] || continue
    mv "$TODO_ROOT/$old" "$TODO_ROOT/$new" \
      || fail "cannot rename $TODO_ROOT/$old to $TODO_ROOT/$new"
  done
  # Moving the files is not enough: the live directory's name is literal text in
  # every index row, and `add` recovers the line it wrote by grepping for it. The
  # month indexes are the opposite case and travel with the archive unrewritten —
  # their lines carry no directory prefix.
  if [ -f "$TODO_ROOT/$INDEX_NAME" ]; then
    write_index "$TODO_ROOT" || fail "cannot write $TODO_ROOT/$INDEX_NAME"
  fi
  release_lock
  note "$TODO_ROOT was renamed once from the older file names: it now uses $INDEX_NAME, $LIVE_DIR/ and $DONE_DIR/, and a pln older than 1.59.0 cannot read it"
  return 0
}

create_todo() {
  local root="$1"
  # Never write through a link: an empty `pln` symlink would put the to-do list
  # outside the repository while the location answer applied to the link.
  if [ -L "$root" ]; then return 1; fi
  # Before anything is created: an existing store under the older names is
  # migrated here, on every leg, or the creation below would race it.
  migrate_store "$root"
  mkdir -p "$root/$LIVE_DIR" 2>/dev/null || return 1
  if [ -L "$root/$LIVE_DIR" ]; then return 1; fi
  TODO_ROOT="$(abs_dir "$root")"
  if [ ! -e "$TODO_ROOT/$INDEX_NAME" ]; then
    write_index "$TODO_ROOT" || return 1
    CREATED=1
  fi
  return 0
}

instruction_leg() {
  local cand="$1" spare="${2:-}"
  instruction_root_ok "$cand" || return 1
  if [ -e "$cand" ] || [ -L "$cand" ]; then
    adopt_candidate "$cand" 'instructions' '' "$spare" || return 1
  else
    TODO_ROOT="$cand"
  fi
  if ! instruction_root_ok "$TODO_ROOT"; then TODO_ROOT=''; RESOLVED_BY=''; return 1; fi
  if ! create_todo "$TODO_ROOT"; then
    note "instructions: cannot create or write $TODO_ROOT"
    TODO_ROOT=''; RESOLVED_BY=''
    return 1
  fi
  RESOLVED_BY='instructions'
  return 0
}

declared_abs() {
  # The declared path made absolute, or nothing when the instructions declare none.
  local declared cand
  declared="$(declared_path || true)"
  [ -n "$declared" ] || return 1
  case "$declared" in
    /*) cand="$declared" ;;
    '~/'*) cand="$HOME/${declared#\~/}" ;;
    *) cand="$PROJECT_TOP/$declared" ;;
  esac
  printf '%s\n' "$cand"
}

# An earlier leg wins before the instruction leg is ever tried, so a project that
# answered "the shared git directory" would never read a to-do location its own
# instructions declare later, and the one-time offer to migrate what is in that
# file could never fire. The to-do list does not move — the offer is about lifting a
# named file's contents into the to-do list, not relocating the to-do list — so the leg
# still wins and simply reports what it passed over.
note_declared_elsewhere() {
  local cand
  cand="$(declared_abs)" || return 0
  [ -n "$cand" ] || return 0
  case "$cand" in "$TODO_ROOT" | "$TODO_ROOT"/*) return 0 ;; esac
  DECLARED_TODO="$cand"
  note "instructions: $cand is declared but the to-do list already resolved to $TODO_ROOT"
  return 0
}

# The four legs, in the user's order. $1 = 1 to create when nothing resolves,
# $2 = an explicit root (an answered location question) or ''.
resolve_root() {
  local create="$1" explicit="${2:-}" cand declared named_file

  if [ -n "$explicit" ]; then
    case "$explicit" in
      /*) cand="$explicit" ;;
      '~/'*) cand="$HOME/${explicit#\~/}" ;;
      *) cand="$PROJECT_DIR/$explicit" ;;
    esac
    [ ! -L "$cand" ] || fail "the to-do-list root must not be a symlink: $cand"
    if [ -e "$cand" ] && [ ! -d "$cand" ]; then fail "the to-do-list root is not a directory: $cand"; fi
    create_todo "$cand" || fail "cannot create or write the to-do list at $cand"
    RESOLVED_BY='explicit'
    return 0
  fi

  if adopt_candidate "$PROJECT_TOP/pln" 'project-root' 'pln'; then
    create_todo "$TODO_ROOT" || fail "cannot write the to-do list at $TODO_ROOT"
    note_declared_elsewhere
    return 0
  fi

  if [ "$IN_WORKTREE" = 1 ] && [ -n "$COMMON_DIR" ]; then
    if adopt_candidate "$COMMON_DIR/pln" 'common-dir'; then
      create_todo "$TODO_ROOT" || fail "cannot write the to-do list at $TODO_ROOT"
      note_declared_elsewhere
      return 0
    fi
  fi

  declared="$(declared_path || true)"
  if [ -n "$declared" ]; then
    case "$declared" in
      /*) cand="$declared" ;;
      '~/'*) cand="$HOME/${declared#\~/}" ;;
      *) cand="$PROJECT_TOP/$declared" ;;
    esac
    # A named file makes its containing directory the root; the file itself is
    # left untouched, and does not count against the directory being empty —
    # otherwise a named file could never produce a root and the migration offer
    # it exists for could never fire.
    named_file=''
    if [ -f "$cand" ] && [ ! -L "$cand" ]; then
      named_file="$(basename "$cand")"
      cand="$(dirname "$cand")"
    fi
    if instruction_leg "$cand" "$named_file"; then
      if [ -n "$named_file" ]; then note "instructions: derived the root from the named file $named_file, which is left as it is"; fi
      return 0
    fi
  fi

  [ "$create" = 1 ] || return 1

  # Create and ask. The default root is only usable when nothing is already
  # sitting on it: a `pln` the legs above refused — a symlink, a submodule
  # mountpoint, someone else's directory — must not be written into here either.
  cand="$PROJECT_TOP/pln"
  if [ -e "$cand" ] || [ -L "$cand" ]; then
    report_notes
    refuse "the default to-do-list root $cand exists and is not a to-do list; nothing was written"
  fi
  if [ "$IS_BARE" = 1 ]; then
    report_notes
    refuse "$PROJECT_DIR is a bare repository; a to-do list is not created inside one"
  fi
  create_todo "$cand" || { report_notes; refuse "no to-do-list root could be created; tried $cand"; }
  RESOLVED_BY='created'
  return 0
}

LOCATION_QUESTION=''
MIGRATION_OFFERED=''
DECLARED_TODO=''

header_field() {
  # $1 = index file, $2 = key
  [ -f "$1" ] || return 0
  LC_ALL=C awk -v key="$2" -v hopen="$HEADER_OPEN" -v hclose="$HEADER_CLOSE" '
    NR == 1 { if ($0 != hopen) exit 0; inhdr = 1; next }
    inhdr && $0 == hclose { exit 0 }
    inhdr {
      i = index($0, ":")
      if (i > 0 && substr($0, 1, i - 1) == key) {
        v = substr($0, i + 1)
        sub(/^[ \t]+/, "", v); sub(/[ \t\r]+$/, "", v)
        print v
        exit 0
      }
    }
  ' "$1"
}

load_header() {
  local answered offered
  LOCATION_QUESTION='owed'
  MIGRATION_OFFERED='none'
  answered="$(header_field "$TODO_ROOT/$INDEX_NAME" 'location-answered')"
  offered="$(header_field "$TODO_ROOT/$INDEX_NAME" 'migration-offered')"
  if [ -n "$answered" ]; then LOCATION_QUESTION='answered'; fi
  if [ -n "$offered" ]; then MIGRATION_OFFERED="$offered"; fi
  return 0
}

report_notes() {
  local n
  for n in ${NOTES[@]+"${NOTES[@]}"}; do printf 'NOTE=%s\n' "$n"; done
}

report_resolution() {
  local n
  printf 'TODO_ROOT=%s\n' "$TODO_ROOT"
  printf 'INDEX=%s\n' "$TODO_ROOT/$INDEX_NAME"
  printf 'RESOLVED_BY=%s\n' "$RESOLVED_BY"
  printf 'CREATED=%s\n' "$CREATED"
  printf 'LOCATION_QUESTION=%s\n' "$LOCATION_QUESTION"
  printf 'MIGRATION_OFFERED=%s\n' "$MIGRATION_OFFERED"
  printf 'DECLARED_TODO=%s\n' "${DECLARED_TODO:--}"
  report_notes
}

# ------------------------------------------------------------------------- lock

LOCK_HELD=''
LOCK_STALE_GRACE=120
INDEX_REFRESHED=1

release_lock() {
  if [ -n "$LOCK_HELD" ]; then
    rm -f "$LOCK_HELD/owner" 2>/dev/null || true
    rmdir "$LOCK_HELD" 2>/dev/null || true
  fi
  LOCK_HELD=''
  return 0
}

lock_owner() {
  # pid<TAB>host<TAB>when, or nothing when the holder left no owner file.
  [ -f "$1/owner" ] || return 1
  LC_ALL=C head -1 "$1/owner" 2>/dev/null
}

lock_owner_desc() {
  local owner pid host when
  owner="$(lock_owner "$1")" || { printf 'an unidentified run'; return 0; }
  pid="$(printf '%s' "$owner" | LC_ALL=C cut -f1)"
  host="$(printf '%s' "$owner" | LC_ALL=C cut -f2)"
  when="$(printf '%s' "$owner" | LC_ALL=C cut -f3)"
  printf 'pid %s on %s since %s' "${pid:-?}" "${host:-?}" "${when:-?}"
}

# A lock is a directory, so a run killed between taking it and releasing it —
# a sandbox timeout, an OOM, a hard interrupt — leaves one that never expires,
# and every later call fails against a holder that no longer exists. Break one
# only where the evidence says the holder is gone: same host, and a pid that is
# not running. Anything else (another host, an unreadable owner file) is left
# alone and waited on, then reported, because guessing wrong here means two
# writers in one to-do list.
lock_is_dead() {
  local lock="$1" owner pid host age
  owner="$(lock_owner "$lock")" || {
    # No owner file at all: either a pre-1.50 lock or one taken microseconds
    # ago by a run that has not written its owner yet. Only the grace period
    # can tell those apart.
    age="$(lock_age "$lock")" || return 1
    [ "$age" -ge "$LOCK_STALE_GRACE" ] || return 1
    return 0
  }
  pid="$(printf '%s' "$owner" | LC_ALL=C cut -f1)"
  host="$(printf '%s' "$owner" | LC_ALL=C cut -f2)"
  [ -n "$pid" ] || return 1
  [ "$host" = "$(hostname)" ] || return 1
  kill -0 "$pid" 2>/dev/null && return 1
  return 0
}

lock_age() {
  local mtime now
  mtime="$(stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || true)"
  [ -n "$mtime" ] || return 1
  now="$(date +%s)"
  printf '%s\n' "$((now - mtime))"
}

# $1 = 1 to fail when the lock cannot be taken, 0 to return non-zero instead.
take_lock() {
  local required="${1:-1}" lock="$TODO_ROOT/.lock" tries=0
  while ! mkdir "$lock" 2>/dev/null; do
    if lock_is_dead "$lock"; then
      note "cleared a lock left behind by $(lock_owner_desc "$lock"), which is no longer running"
      rm -f "$lock/owner" 2>/dev/null || true
      rmdir "$lock" 2>/dev/null || true
      continue
    fi
    tries=$((tries + 1))
    if [ "$tries" -ge 25 ]; then
      [ "$required" = 1 ] || return 1
      fail "the to-do list is locked by $(lock_owner_desc "$lock"): $lock
If that run is gone, clear it with: rmdir $lock
Do not read $TODO_ROOT/$INDEX_NAME by hand instead — the index carries no holder, so it cannot tell you what another run has claimed."
    fi
    sleep 0.2
  done
  printf '%s\t%s\t%s\n' "$$" "$(hostname)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$lock/owner" 2>/dev/null || true
  LOCK_HELD="$lock"
  trap 'release_lock' EXIT
  return 0
}

# ----------------------------------------------------------- reading the record

detail_path() { printf '%s/%s/%s.md\n' "$TODO_ROOT" "$LIVE_DIR" "$1"; }

# One tab-separated record per detail file:
#   id  state  urgent  status  opened  group  claimed_by  claimed_at  claim  claimed_in
# `claimed_in` is last because it is additive: a record written before it existed
# reads back empty, which matches no claiming worktree and so exempts nothing.
parse_detail() {
  local file="$1"
  LC_ALL=C awk -v file="$file" '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
    function unquote(s) { if (s ~ /^".*"$/) s = substr(s, 2, length(s) - 2); return s }
    NR == 1 { if ($0 != "---") { print "pln-todo: detail file has no frontmatter: " file > "/dev/stderr"; bad = 1; exit 1 } inhdr = 1; next }
    inhdr && $0 == "---" { inhdr = 0; next }
    inhdr {
      i = index($0, ":")
      if (i > 0) v[trim(substr($0, 1, i - 1))] = unquote(trim(substr($0, i + 1)))
      next
    }
    !claim && /^# / { claim = trim(substr($0, 3)) }
    END {
      if (bad) exit 1
      if (inhdr) { print "pln-todo: unterminated frontmatter: " file > "/dev/stderr"; exit 1 }
      if (v["id"] == "" || v["state"] == "" || v["status"] == "") {
        print "pln-todo: detail file is missing id, state or status: " file > "/dev/stderr"; exit 1
      }
      if (claim == "") { print "pln-todo: detail file has no leading `# <claim>` heading: " file > "/dev/stderr"; exit 1 }
      urgent = (v["urgent"] == "true") ? "true" : "false"
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", v["id"], v["state"], urgent, v["status"], \
        v["opened"], v["group"], v["claimed_by"], v["claimed_at"], claim, v["claimed_in"]
    }
  ' "$file"
}

# The values of one list-valued frontmatter field, one per line.
detail_list() {
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  LC_ALL=C awk -v key="$key" '
    NR == 1 { if ($0 != "---") exit 0; inhdr = 1; next }
    inhdr && $0 == "---" { exit 0 }
    inhdr {
      i = index($0, ":")
      if (i > 0) {
        k = substr($0, 1, i - 1); sub(/^[ \t]+/, "", k); sub(/[ \t]+$/, "", k)
        if (k == key) {
          v = substr($0, i + 1)
          sub(/^[ \t]*\[/, "", v); sub(/\][ \t\r]*$/, "", v)
          n = split(v, parts, ",")
          for (j = 1; j <= n; j++) {
            p = parts[j]
            sub(/^[ \t]+/, "", p); sub(/[ \t\r]+$/, "", p)
            gsub(/^"|"$/, "", p)
            if (p != "") print p
          }
          exit 0
        }
      }
    }
  ' "$file"
}

live_records() {
  local file
  [ -d "$TODO_ROOT/$LIVE_DIR" ] || return 0
  for file in "$TODO_ROOT/$LIVE_DIR"/*.md; do
    [ -f "$file" ] || continue
    parse_detail "$file" || return 1
  done
  return 0
}

# --------------------------------------------------------------- the index file

render_index() {
  local answered offered records
  answered="$(header_field "$TODO_ROOT/$INDEX_NAME" 'location-answered')"
  offered="$(header_field "$TODO_ROOT/$INDEX_NAME" 'migration-offered')"
  if [ -n "$SET_ANSWERED" ]; then answered="$SET_ANSWERED"; fi
  if [ -n "$SET_OFFERED" ]; then offered="$SET_OFFERED"; fi

  printf '%s\n' "$HEADER_OPEN"
  printf 'queue-root: %s\n' "$TODO_ROOT"
  if [ -n "$answered" ]; then printf 'location-answered: %s\n' "$answered"; fi
  if [ -n "$offered" ]; then printf 'migration-offered: %s\n' "$offered"; fi
  printf '%s\n\n' "$HEADER_CLOSE"

  records="$(live_records)" || return 1
  if [ -z "$records" ]; then
    printf '_No open items._\n'
    return 0
  fi

  # bucket \t group \t opened-key \t id \t line — a total order, so two runs over
  # an unchanged set of detail files cannot produce two different files.
  printf '%s\n' "$records" | LC_ALL=C awk -F '\t' -v OFS='\t' -v live="$LIVE_DIR" '
    {
      id = $1; state = $2; urgent = $3; status = $4; opened = $5; group = $6; claim = $9
      by = $7; where = $10
      flag = (urgent == "true") ? "! " : ""
      # The holder, where there is one. A run string is not unique on its own, so
      # the worktree it claimed from rides with it — a record written before
      # `claimed_in` existed names the run alone rather than inventing a tree.
      held = ""
      if (by != "") {
        held = " · held by " by
        if (where != "") {
          sub(/\/+$/, "", where)
          n = split(where, seg, "/")
          if (seg[n] != "") held = held " in " seg[n]
        }
      }
      line = "- " state " " flag status " · " claim " → `" live "/" id ".md`" held
      bucket = (urgent == "true") ? "0" : (group != "" ? "1" : "2")
      key = (opened != "") ? "0" opened : "1"
      print bucket, group, key, id, line
    }
  ' | LC_ALL=C sort -t"$(printf '\t')" -k1,1 -k2,2 -k3,3 -k4,4 | LC_ALL=C awk -F '\t' '
    {
      heading = ($1 == "0") ? "Urgent" : ($1 == "2" ? "Everything else" : $2)
      if (heading != current) {
        if (NR > 1) printf "\n"
        printf "## %s\n\n", heading
        current = heading
      }
      print $5
    }
  '
}

write_index() {
  local root="${1:-$TODO_ROOT}" tmp
  TODO_ROOT="$root"
  [ ! -L "$root/$INDEX_NAME" ] || fail "the index file must not be a symlink: $root/$INDEX_NAME"
  tmp="$(mktemp "$root/.pln-todo-index.XXXXXX")" || return 1
  if ! render_index > "$tmp"; then rm -f "$tmp"; return 1; fi
  mv "$tmp" "$root/$INDEX_NAME"
}

index_line_for() {
  LC_ALL=C grep -F -- "\`$LIVE_DIR/$1.md\`" "$TODO_ROOT/$INDEX_NAME" | head -1
}

# ----------------------------------------------------------------- the overlap

overlap_report() {
  # $1 = subject id, $2 = other id, $3 = the run asking, $4 = the worktree it is
  # asking from ('' for either = no exemption). One COLLISION line per shared
  # claim; an EXEMPT line where a path overlap was passed over.
  #
  # The exemption lives here, per pair, and never in the derivation of the
  # compared set: one pair can emit both a `path` and a `resource` collision, so
  # dropping the item from the set would drop its `holds` check with it. It
  # covers `path` only — a shared `holds` resource, and an undeclared `touches`,
  # keep refusing whoever asks.
  local a="$1" b="$2" run="${3:-}" wt="${4:-}" af bf ta tb ha hb x y hit=0
  local exempt=0 other_rec other_run other_wt
  af="$(detail_path "$a")"; bf="$(detail_path "$b")"
  if [ -n "$run" ] && [ -n "$wt" ]; then
    other_rec="$(parse_detail "$bf")" || other_rec=''
    other_run="$(printf '%s' "$other_rec" | LC_ALL=C cut -f7)"
    other_wt="$(printf '%s' "$other_rec" | LC_ALL=C cut -f10)"
    if [ -n "$other_run" ] && [ "$other_run" = "$run" ] && [ "$other_wt" = "$wt" ]; then
      exempt=1
    fi
  fi
  ta="$(detail_list "$af" touches)"
  tb="$(detail_list "$bf" touches)"
  ha="$(detail_list "$af" holds)"
  hb="$(detail_list "$bf" holds)"

  if [ -z "$tb" ]; then
    printf 'COLLISION\t%s\tunknown\t%s\n' "$b" "$b declares no touches"
    hit=1
  elif [ -n "$ta" ]; then
    while IFS= read -r x; do
      [ -n "$x" ] || continue
      x="${x%/}"
      while IFS= read -r y; do
        [ -n "$y" ] || continue
        y="${y%/}"
        # Prefix containment in either direction: a directory entry is a claim on
        # a region, not a string to match.
        if [ "$x" = "$y" ] || [ "${x#"$y"/}" != "$x" ] || [ "${y#"$x"/}" != "$y" ]; then
          if [ "$exempt" = 1 ]; then
            printf 'EXEMPT\t%s\tpath\t%s\n' "$b" "$x"
          else
            printf 'COLLISION\t%s\tpath\t%s\n' "$b" "$x"
            hit=1
          fi
        fi
      done <<EOF
$tb
EOF
    done <<EOF
$ta
EOF
  fi

  if [ -n "$ha" ] && [ -n "$hb" ]; then
    while IFS= read -r x; do
      [ -n "$x" ] || continue
      while IFS= read -r y; do
        [ -n "$y" ] || continue
        if [ "$x" = "$y" ]; then
          printf 'COLLISION\t%s\tresource\t%s\n' "$b" "$x"
          hit=1
        fi
      done <<EOF
$hb
EOF
    done <<EOF
$ha
EOF
  fi
  [ "$hit" = 0 ] || return 1
  return 0
}

claimed_ids() {
  live_records | LC_ALL=C awk -F '\t' '$7 != "" { print $1 }'
}

run_check() {
  # $1 = subject id, $2 = CSV of ids to compare against ('' = the claimed set),
  # $3 = the run asking (or ''), $4 = the worktree it is asking from (or '').
  local id="$1" against="$2" run="${3:-}" wt="${4:-}"
  local others other refused=0 subject_touches
  subject_touches="$(detail_list "$(detail_path "$id")" touches)"

  if [ -n "$against" ]; then
    others="$(csv_to_lines "$against")"
    # A caller-named set is honored verbatim: the seam the exemption answers is
    # in the derivation, and the caller named this set themselves.
    run=''; wt=''
  else
    others="$(claimed_ids)"
  fi

  # Absent means unknown, and unknown collides with everything: otherwise the
  # cheapest capture would be the most permissive thing in the to-do list.
  if [ -z "$subject_touches" ]; then
    printf 'COLLISION\t-\tunknown\t%s\n' "$id declares no touches"
    refused=1
  fi

  while IFS= read -r other; do
    [ -n "$other" ] || continue
    [ "$other" != "$id" ] || continue
    [ -f "$(detail_path "$other")" ] || fail "no such to-do item: $other"
    if ! overlap_report "$id" "$other" "$run" "$wt"; then refused=1; fi
  done <<EOF
$others
EOF

  if [ "$refused" = 1 ]; then
    printf 'CHECK=refused\n'
    return 1
  fi
  printf 'CHECK=clear\n'
  return 0
}

# ------------------------------------------------------------------ frontmatter

set_field() {
  # $1 = detail file, $2 = key, $3 = value (already YAML-safe)
  local file="$1" key="$2" value="$3" tmp
  tmp="$(mktemp "$(dirname "$file")/.pln-todo-detail.XXXXXX")"
  LC_ALL=C awk -v key="$key" -v value="$value" '
    NR == 1 { print; inhdr = 1; next }
    inhdr && $0 == "---" {
      if (!done) { print key ": " value; done = 1 }
      inhdr = 0; print; next
    }
    inhdr {
      i = index($0, ":")
      if (i > 0) {
        k = substr($0, 1, i - 1); sub(/^[ \t]+/, "", k); sub(/[ \t]+$/, "", k)
        if (k == key) { print key ": " value; done = 1; next }
      }
      print; next
    }
    { print }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

append_sub_item() {
  local file="$1" text="$2" state="$3" tmp
  tmp="$(mktemp "$(dirname "$file")/.pln-todo-detail.XXXXXX")"
  LC_ALL=C awk -v line="- $state $text" '
    { lines[++n] = $0; if ($0 == "## Sub-items") found = NR }
    END {
      if (!found) {
        while (n > 0 && lines[n] == "") n--
        for (i = 1; i <= n; i++) print lines[i]
        print ""
        print "## Sub-items"
        print ""
        print line
      } else {
        last = found
        for (i = found + 1; i <= n; i++) {
          if (lines[i] ~ /^## /) break
          if (lines[i] != "") last = i
        }
        for (i = 1; i <= last; i++) print lines[i]
        print line
        for (i = last + 1; i <= n; i++) print lines[i]
      }
    }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

# --------------------------------------------------------------------- dispatch

command="${1:-}"
[ -n "$command" ] || usage
shift

project='.'
create_flag=1

case "$command" in list | check | stale) READ_ONLY_CMD=1 ;; esac

case "$command" in
  init)
    explicit=''; answered=0; migration=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --project) project="${2:-}"; shift 2 ;;
        --root) explicit="${2:-}"; shift 2 ;;
        --answered) answered=1; shift ;;
        --migration-offered) migration=1; shift ;;
        --no-create) create_flag=0; shift ;;
        *) usage ;;
      esac
    done
    project_context "$project"
    resolve_root "$create_flag" "$explicit" || refuse "no to-do list could be resolved under $PROJECT_DIR"
    if [ "$answered" = 1 ] || [ "$migration" = 1 ]; then
      take_lock
      if [ "$answered" = 1 ]; then SET_ANSWERED="$(today)"; fi
      if [ "$migration" = 1 ]; then SET_OFFERED="$(today)"; fi
      write_index "$TODO_ROOT" || fail "cannot write $TODO_ROOT/$INDEX_NAME"
      release_lock
    fi
    load_header
    report_resolution
    ;;

  add)
    id=''; claim=''; source=''; status='ready'; state='[ ]'; urgent='false'
    group=''; opened=''; depends=''; touches=''; holds=''; body=''
    while [ $# -gt 0 ]; do
      case "$1" in
        --project) project="${2:-}"; shift 2 ;;
        --id) id="${2:-}"; shift 2 ;;
        --claim) claim="${2:-}"; shift 2 ;;
        --source) source="${2:-}"; shift 2 ;;
        --status) status="${2:-}"; shift 2 ;;
        --state) state="${2:-}"; shift 2 ;;
        --urgent) urgent='true'; shift ;;
        --group) group="${2:-}"; shift 2 ;;
        --opened) opened="${2:-}"; shift 2 ;;
        --depends-on) depends="${2:-}"; shift 2 ;;
        --touches) touches="${2:-}"; shift 2 ;;
        --holds) holds="${2:-}"; shift 2 ;;
        --body) body="${2:-}"; shift 2 ;;
        --no-create) create_flag=0; shift ;;
        *) usage ;;
      esac
    done
    [ -n "$id" ] && [ -n "$claim" ] && [ -n "$source" ] || usage
    valid_id "$id" || fail "id must be lowercase letters, digits and hyphens: $id"
    valid_state "$state" || fail "state must be '[ ]', '[-]' or '[x]': $state"
    valid_status "$status" || fail "status must be ready, blocked, decide or dropped: $status"
    single_line 'claim' "$claim"
    single_line 'source' "$source"
    single_line 'group' "$group"
    [ -n "$opened" ] || opened="$(today)"
    case "$opened" in
      [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
      *) fail "opened must be YYYY-MM-DD: $opened" ;;
    esac

    project_context "$project"
    resolve_root "$create_flag" '' || refuse "no to-do list could be resolved under $PROJECT_DIR"
    take_lock

    detail="$(detail_path "$id")"
    if [ -e "$detail" ] || [ -L "$detail" ]; then
      refuse "an item is already filed at $detail; nothing was overwritten"
    fi
    mkdir -p "$TODO_ROOT/$LIVE_DIR"

    depends_yaml="$(csv_to_lines "$depends" | lines_to_yaml_list)"
    touches_yaml="$(csv_to_lines "$touches" | lines_to_yaml_list)"
    holds_yaml="$(csv_to_lines "$holds" | lines_to_yaml_list)"

    tmp="$(mktemp "$TODO_ROOT/$LIVE_DIR/.pln-todo-add.XXXXXX")"
    {
      printf -- '---\n'
      printf 'id: %s\n' "$id"
      printf 'state: "%s"\n' "$state"
      printf 'urgent: %s\n' "$urgent"
      printf 'status: %s\n' "$status"
      printf 'opened: %s\n' "$opened"
      printf 'source: %s\n' "$source"
      printf 'group: %s\n' "$group"
      printf 'depends_on: %s\n' "$depends_yaml"
      printf 'touches: %s\n' "$touches_yaml"
      printf 'holds: %s\n' "$holds_yaml"
      printf -- '---\n\n'
      printf '# %s\n\n' "$claim"
      if [ -n "$body" ]; then
        if [ "$body" = '-' ]; then cat; else cat "$body"; fi
      else
        printf '## What exists and where\n\n_Not recorded when this item was filed._\n\n'
        printf '## What to do\n\n_Not recorded when this item was filed._\n\n'
        printf '## What has to be true first\n\n_Not recorded when this item was filed._\n\n'
        printf '## How to tell it worked\n\n_Not recorded when this item was filed._\n\n'
        printf '## Related\n\n- filed from: %s\n\n' "$source"
        printf '## Sub-items\n'
      fi
    } > "$tmp"
    # The detail file is canonical, so it lands first: an interruption leaves an
    # orphan the next rebuild picks up, never a phantom index line.
    mv "$tmp" "$detail"
    write_index "$TODO_ROOT" || fail "cannot write $TODO_ROOT/$INDEX_NAME"
    release_lock

    load_header
    report_resolution
    printf 'DETAIL_FILE=%s\n' "$detail"
    line="$(index_line_for "$id")"
    [ -n "$line" ] || fail "the index was rebuilt without $id"
    printf 'INDEX_LINE=%s\n' "$line"
    ;;

  list)
    while [ $# -gt 0 ]; do
      case "$1" in
        --project) project="${2:-}"; shift 2 ;;
        --no-create) create_flag=0; shift ;;
        *) usage ;;
      esac
    done
    project_context "$project"
    resolve_root "$create_flag" '' || refuse "no to-do list could be resolved under $PROJECT_DIR"
    # `list` is a read to whoever calls it, and it must never be the thing that
    # fails: everything it prints is derived from the detail files, and only the
    # refresh of the on-disk index needs the lock. A caller that cannot read the
    # to-do list reaches for `TO-DO.md` by hand, which carries no holder and so
    # reports another run's claimed items as untaken — the failure this guards.
    if take_lock 0; then
      write_index "$TODO_ROOT" || fail "cannot write $TODO_ROOT/$INDEX_NAME"
      release_lock
      INDEX_REFRESHED=1
    else
      note "the to-do list is locked by $(lock_owner_desc "$TODO_ROOT/.lock"), so the index file was not refreshed; everything below is read from the detail files and is current"
      INDEX_REFRESHED=0
    fi
    load_header
    report_resolution
    printf 'INDEX_REFRESHED=%s\n' "$INDEX_REFRESHED"
    count="$(live_records | LC_ALL=C grep -c '' || true)"
    [ -n "$count" ] || count=0
    printf 'ITEM_COUNT=%s\n' "$count"
    if [ "$count" = "0" ]; then printf 'STATUS=empty\n'; else printf 'STATUS=items\n'; fi
    # The output is never empty, so a caller can tell an empty to-do list — a real
    # read — from a failed call, which must fail the close rather than render
    # a clean empty follow-up list.
    printf 'INDEX_BEGIN\n'
    # Refreshed or not, what is printed is derived from the detail files this
    # instant. Catting an index the lock stopped us rewriting would hand back
    # the stale file the fallback above exists to keep nobody reading.
    if [ "$INDEX_REFRESHED" = 1 ]; then
      cat "$TODO_ROOT/$INDEX_NAME"
    else
      render_index || fail "cannot render the to-do list at $TODO_ROOT"
    fi
    printf 'INDEX_END\n'
    ;;

  check)
    id=''; against=''; run=''
    while [ $# -gt 0 ]; do
      case "$1" in
        --project) project="${2:-}"; shift 2 ;;
        --id) id="${2:-}"; shift 2 ;;
        --against) against="${2:-}"; shift 2 ;;
        --run) run="${2:-}"; shift 2 ;;
        --no-create) create_flag=0; shift ;;
        *) usage ;;
      esac
    done
    [ -n "$id" ] || usage
    [ -z "$run" ] || single_line 'run' "$run"
    project_context "$project"
    resolve_root "$create_flag" '' || refuse "no to-do list could be resolved under $PROJECT_DIR"
    load_header
    report_resolution
    [ -f "$(detail_path "$id")" ] || fail "no such to-do item: $id"
    # Advisory by contract: two runs can both read a clear result, which is why
    # `claim` exists and why a refusal here is not an error. Advisory is allowed
    # to be conservative, never to disagree: without `--run` this reports every
    # overlap, and `--run R` sees exactly what `claim --run R` would see.
    run_check "$id" "$against" "$run" "$PROJECT_TOP" || true
    ;;

  claim)
    id=''; run=''; against=''; steal=''
    claim_touches=''; claim_holds=''; have_claim_touches=0; have_claim_holds=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --project) project="${2:-}"; shift 2 ;;
        --id) id="${2:-}"; shift 2 ;;
        --run) run="${2:-}"; shift 2 ;;
        --touches) claim_touches="${2:-}"; have_claim_touches=1; shift 2 ;;
        --holds) claim_holds="${2:-}"; have_claim_holds=1; shift 2 ;;
        --against) against="${2:-}"; shift 2 ;;
        --steal) steal="${2:-}"; shift 2 ;;
        --no-create) create_flag=0; shift ;;
        *) usage ;;
      esac
    done
    [ -n "$id" ] && [ -n "$run" ] || usage
    single_line 'run' "$run"
    project_context "$project"
    resolve_root "$create_flag" '' || refuse "no to-do list could be resolved under $PROJECT_DIR"
    load_header
    report_resolution
    detail="$(detail_path "$id")"
    [ -f "$detail" ] || fail "no such to-do item: $id"

    # One mkdir lock over both the check and the record. A bare check cannot
    # enforce a refusal: two runs can each read a clear answer and both proceed.
    take_lock
    holder="$(parse_detail "$detail")" || holder=''
    holder_wt="$(printf '%s' "$holder" | LC_ALL=C cut -f10)"
    holder="$(printf '%s' "$holder" | LC_ALL=C cut -f7)"
    # A run string is not a holder on its own — the same `<date>-<slug>` can be
    # live in two trees that share one declared root. The pair is what holds,
    # exactly as the overlap exemption already reads it, so a re-claim is only
    # the holder's own when both halves match. An older record carrying no
    # `claimed_in` matches no tree and is released by `--steal` like any other.
    held_elsewhere=0
    if [ -n "$holder" ] && { [ "$holder" != "$run" ] || [ "$holder_wt" != "$PROJECT_TOP" ]; }; then
      held_elsewhere=1
    fi
    if [ "$held_elsewhere" = 1 ]; then
      if [ -n "$holder_wt" ]; then held_desc="$holder in $holder_wt"; else held_desc="$holder"; fi
      if [ -z "$steal" ]; then
        printf 'CLAIM=refused\nHELD_BY=%s\nHELD_IN=%s\n' "$holder" "${holder_wt:--}"
        refuse "$id is held by $held_desc; a stale holder is released only by --steal $holder"
      fi
      if [ "$steal" != "$holder" ]; then
        printf 'CLAIM=refused\nHELD_BY=%s\nHELD_IN=%s\n' "$holder" "${holder_wt:--}"
        refuse "--steal names $steal but $id is held by $held_desc; nothing was released"
      fi
    fi
    # Taking an item is the moment somebody has actually looked at it, so it is
    # the moment its write set can be declared. Filing stays free — one sentence,
    # no fields — and the field that answers parallel-safety gets filled by the
    # run that just read the item, under the same lock the check runs in, so the
    # check below sees what was declared rather than the empty field it was
    # filed with.
    [ "$have_claim_touches" = 0 ] || set_field "$detail" 'touches' \
      "$(csv_to_lines "$claim_touches" | lines_to_yaml_list)"
    [ "$have_claim_holds" = 0 ] || set_field "$detail" 'holds' \
      "$(csv_to_lines "$claim_holds" | lines_to_yaml_list)"
    set +e
    check_out="$(run_check "$id" "$against" "$run" "$PROJECT_TOP")"
    check_rc=$?
    set -e
    printf '%s\n' "$check_out"
    if [ "$check_rc" != 0 ]; then
      printf 'CLAIM=refused\n'
      if [ -z "$(detail_list "$detail" touches)" ]; then
        refuse "$id declares no touches, so nothing can be said about running it beside anything else; declare its write set on the claim: --touches <paths>"
      fi
      refuse "$id collides with the declared set; it is not parallel-safe yet"
    fi
    set_field "$detail" 'claimed_by' "$run"
    set_field "$detail" 'claimed_at' "$(today)"
    # The worktree travels with the run because a run string is not unique on its
    # own: two repositories whose instructions declare one to-do-list root can carry
    # the same `<date>-<slug>` on one day, with no scheduler edge between them.
    set_field "$detail" 'claimed_in' "$PROJECT_TOP"
    write_index "$TODO_ROOT" || fail "cannot write $TODO_ROOT/$INDEX_NAME"
    release_lock
    if [ "$held_elsewhere" = 1 ]; then printf 'STOLEN_FROM=%s\n' "$holder"; fi
    printf 'CLAIM=held\nHELD_BY=%s\n' "$run"
    # Read the write set back off the record rather than echoing the argument:
    # what the next claim is checked against is what the file now says.
    printf 'TOUCHES=%s\n' "$(detail_list "$detail" touches | paste -sd, - )"
    ;;

  mark)
    id=''; sub=''; sub_state='[ ]'; mark_run=''
    set_state=''; set_status=''; set_urgent=''; set_group=''
    set_touches=''; set_holds=''; set_depends=''; set_source=''
    have_group=0; have_touches=0; have_holds=0; have_depends=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --project) project="${2:-}"; shift 2 ;;
        --id) id="${2:-}"; shift 2 ;;
        --run) mark_run="${2:-}"; shift 2 ;;
        --state) set_state="${2:-}"; shift 2 ;;
        --status) set_status="${2:-}"; shift 2 ;;
        --urgent) set_urgent="${2:-}"; shift 2 ;;
        --group) set_group="${2:-}"; have_group=1; shift 2 ;;
        --touches) set_touches="${2:-}"; have_touches=1; shift 2 ;;
        --holds) set_holds="${2:-}"; have_holds=1; shift 2 ;;
        --depends-on) set_depends="${2:-}"; have_depends=1; shift 2 ;;
        --source) set_source="${2:-}"; shift 2 ;;
        --add-sub-item) sub="${2:-}"; shift 2 ;;
        --sub-item-state) sub_state="${2:-}"; shift 2 ;;
        --no-create) create_flag=0; shift ;;
        *) usage ;;
      esac
    done
    [ -n "$id" ] || usage
    [ -z "$set_state" ] || valid_state "$set_state" || fail "state must be '[ ]', '[-]' or '[x]': $set_state"
    [ -z "$set_status" ] || valid_status "$set_status" || fail "status must be ready, blocked, decide or dropped: $set_status"
    if [ -n "$set_urgent" ]; then
      case "$set_urgent" in true | false) ;; *) fail "urgent must be true or false: $set_urgent" ;; esac
    fi
    [ -z "$sub" ] || valid_state "$sub_state" || fail "sub-item state must be '[ ]', '[-]' or '[x]': $sub_state"
    single_line 'sub-item' "$sub"
    single_line 'group' "$set_group"

    project_context "$project"
    resolve_root "$create_flag" '' || refuse "no to-do list could be resolved under $PROJECT_DIR"
    detail="$(detail_path "$id")"
    [ -f "$detail" ] || fail "no such to-do item: $id"
    take_lock
    # Marking is how a run records what it finished, so it may not be done to a
    # record someone else is holding: `claim --steal` moves a holder without
    # telling the run it displaced, and without this a displaced run could still
    # write a completion the to-do list no longer backs — and its plan would record a
    # success nobody could reconcile. An unheld record is marked by anyone, as
    # before. A run that really did the work takes the item back first, which is
    # also how the run that stole it learns the steal was contested.
    mark_holder="$(parse_detail "$detail")" || mark_holder=''
    mark_holder_wt="$(printf '%s' "$mark_holder" | LC_ALL=C cut -f10)"
    mark_holder="$(printf '%s' "$mark_holder" | LC_ALL=C cut -f7)"
    if [ -n "$mark_holder" ] \
      && { [ "$mark_run" != "$mark_holder" ] || [ "$PROJECT_TOP" != "$mark_holder_wt" ]; }; then
      release_lock
      printf 'MARK=refused\nHELD_BY=%s\nHELD_IN=%s\n' "$mark_holder" "${mark_holder_wt:--}"
      if [ -n "$mark_holder_wt" ]; then mark_desc="$mark_holder in $mark_holder_wt"; else mark_desc="$mark_holder"; fi
      refuse "$id is held by $mark_desc; take it back with claim --steal $mark_holder before marking it"
    fi
    # The helper owns the frontmatter and the sub-item checklist it appends to,
    # and nothing else in the body.
    [ -z "$set_state" ] || set_field "$detail" 'state' "\"$set_state\""
    [ -z "$set_status" ] || set_field "$detail" 'status' "$set_status"
    [ -z "$set_urgent" ] || set_field "$detail" 'urgent' "$set_urgent"
    [ "$have_group" = 0 ] || set_field "$detail" 'group' "$set_group"
    [ -z "$set_source" ] || set_field "$detail" 'source' "$set_source"
    [ "$have_touches" = 0 ] || set_field "$detail" 'touches' "$(csv_to_lines "$set_touches" | lines_to_yaml_list)"
    [ "$have_holds" = 0 ] || set_field "$detail" 'holds' "$(csv_to_lines "$set_holds" | lines_to_yaml_list)"
    [ "$have_depends" = 0 ] || set_field "$detail" 'depends_on' "$(csv_to_lines "$set_depends" | lines_to_yaml_list)"
    [ -z "$sub" ] || append_sub_item "$detail" "$sub" "$sub_state"
    write_index "$TODO_ROOT" || fail "cannot write $TODO_ROOT/$INDEX_NAME"
    release_lock
    load_header
    report_resolution
    printf 'DETAIL_FILE=%s\n' "$detail"
    line="$(index_line_for "$id")"
    [ -n "$line" ] || fail "the index was rebuilt without $id"
    printf 'INDEX_LINE=%s\n' "$line"
    ;;

  archive)
    id=''; disposition=''; evidence=''; month=''
    while [ $# -gt 0 ]; do
      case "$1" in
        --project) project="${2:-}"; shift 2 ;;
        --id) id="${2:-}"; shift 2 ;;
        --disposition) disposition="${2:-}"; shift 2 ;;
        --evidence) evidence="${2:-}"; shift 2 ;;
        --month) month="${2:-}"; shift 2 ;;
        --no-create) create_flag=0; shift ;;
        *) usage ;;
      esac
    done
    [ -n "$id" ] && [ -n "$disposition" ] && [ -n "$evidence" ] || usage
    case "$disposition" in
      completed | dropped | superseded | resolved-elsewhere) ;;
      *) fail "disposition must be completed, dropped, superseded or resolved-elsewhere: $disposition" ;;
    esac
    single_line 'evidence' "$evidence"
    if [ -n "$month" ]; then
      case "$month" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]) ;;
        *) fail "month must be YYYY-MM: $month" ;;
      esac
    else
      month="$(today)"; month="${month%-*}"
    fi

    project_context "$project"
    resolve_root "$create_flag" '' || refuse "no to-do list could be resolved under $PROJECT_DIR"
    detail="$(detail_path "$id")"
    [ -f "$detail" ] || fail "no such to-do item: $id"
    record="$(parse_detail "$detail")" || fail "cannot read $detail"
    state="$(printf '%s' "$record" | LC_ALL=C cut -f2)"
    claim="$(printf '%s' "$record" | LC_ALL=C cut -f9)"
    if [ "$disposition" = 'completed' ] && [ "$state" != '[x]' ]; then
      refuse "$id is $state, not [x]; nothing writes a completion nobody verified — mark it, or archive it as resolved-elsewhere"
    fi

    take_lock
    dest_dir="$TODO_ROOT/$DONE_DIR/$month"
    dest="$dest_dir/$id.md"
    if [ -e "$dest" ] || [ -L "$dest" ]; then
      refuse "a record is already archived at $dest; nothing was overwritten"
    fi
    mkdir -p "$dest_dir"
    # Content-preserving order: the record exists at its archive path and its line
    # is in the month index before anything leaves the live to-do list.
    cp "$detail" "$dest"
    set_field "$dest" 'disposition' "$disposition"
    set_field "$dest" 'archived' "$(today)"
    set_field "$dest" 'evidence' "$evidence"
    month_index="$dest_dir/index.md"
    if [ ! -e "$month_index" ]; then printf '## %s\n\n' "$month" > "$month_index"; fi
    printf -- '- %s %s · %s → `%s.md` — %s\n' "$state" "$disposition" "$claim" "$id" "$evidence" >> "$month_index"
    rm -f "$detail"
    write_index "$TODO_ROOT" || fail "cannot write $TODO_ROOT/$INDEX_NAME"
    release_lock

    load_header
    report_resolution
    printf 'ARCHIVED=%s\nARCHIVE_FILE=%s\nARCHIVE_INDEX=%s\nDISPOSITION=%s\nSTATE=%s\n' \
      "$id" "$dest" "$month_index" "$disposition" "$state"
    ;;

  stale)
    days=30
    while [ $# -gt 0 ]; do
      case "$1" in
        --project) project="${2:-}"; shift 2 ;;
        --days) days="${2:-}"; shift 2 ;;
        --no-create) create_flag=0; shift ;;
        *) usage ;;
      esac
    done
    case "$days" in '' | *[!0-9]*) fail "days must be a whole number: $days" ;; esac
    project_context "$project"
    resolve_root "$create_flag" '' || refuse "no to-do list could be resolved under $PROJECT_DIR"
    load_header
    report_resolution
    now="$(today)"
    cutoff="$(cutoff_date "$now" "$days")"
    records="$(live_records)" || fail "cannot read the to-do list's detail files"
    # Report only. Nothing here writes, marks or archives: a record leaves the
    # live to-do list on the user's confirmation, never on this helper's judgment.
    stale_out="$(printf '%s' "$records" | LC_ALL=C awk -F '\t' -v cutoff="$cutoff" '
      NF >= 9 {
        id = $1; state = $2; status = $4; opened = $5; by = $7; at = $8; claim = $9
        reasons = ""
        if (state == "[x]") reasons = "completed-not-archived"
        if (status == "dropped") reasons = reasons == "" ? "dropped-not-archived" : reasons ",dropped-not-archived"
        if (by != "" && at != "" && at <= cutoff)
          reasons = reasons == "" ? "claim-abandoned" : reasons ",claim-abandoned"
        if (reasons == "" && opened != "" && opened <= cutoff) reasons = "aged"
        if (reasons == "") next
        # The claim rides with every candidate, because these ids go straight
        # into a closing message and an id is a filename nobody has read.
        printf "STALE\t%s\t%s\t%s\t%s\n", id, reasons, (by == "" ? "-" : by), claim
      }
    ')"
    if [ -n "$stale_out" ]; then
      printf '%s\n' "$stale_out"
      count="$(printf '%s\n' "$stale_out" | LC_ALL=C grep -c '' || true)"
    else
      count=0
    fi
    printf 'STALE_COUNT=%s\nSTALE_DAYS=%s\nSTALE_CUTOFF=%s\n' "$count" "$days" "$cutoff"
    ;;

  *) usage ;;
esac
