#!/usr/bin/env bash
# pln-update-apply — upgrade EVERY installed copy of pln to the remote version.
#
# This reconciles all install roots (~/.agents, ~/.claude, plus project-local
# .agents/.claude) in one pass, instead of upgrading only the first one found. A
# single stale copy in a root the host loads from is the split-brain bug this
# exists to prevent — see bin/pln-update-check.
#
# It also runs a one-time .codex → .agents consolidation pass first: Codex now
# reads .agents, so any legacy .codex pln copy is moved into the matching .agents
# location (or dropped if one already exists).
#
# Modes:
#   pln-update-apply            reconcile all copies to the remote version
#   pln-update-apply --plan     print what WOULD happen; mutate nothing
#
# Output (parseable; the /pln-update flow relays it):
#   REMOTE <version>
#   MIGRATE <dir> <result>               result: moved|dropped|dev-symlink-skipped|
#                                        move-failed|drop-failed
#   COPY <dir> <old> -> <new> <status>   status: upgraded|unchanged|
#                                        dev-symlink-skipped|stashed|failed:<reason>
#   SUMMARY <oldmin> -> <new> (<u> upgraded, <c> unchanged, <s> skipped, <f> failed)
#
# failed:<reason> — <new> is the version on disk afterwards:
#   not-writable   a write into the copy (git: the copy and its .git; vendored: the
#                  copy and its parent, where the backup goes) was refused before
#                  anything changed — a read-only install, or a sandbox that
#                  confines writes to the workspace
#   fetch-failed   git: `git fetch origin` failed (network, auth, missing remote);
#                  the copy is unchanged
#   reset-failed   git: `git reset --hard origin/main` failed after a fetch
#   clone-failed   vendored: cloning the source failed (network); unchanged
#   backup-failed  vendored: <dir>.bak could not be cleared or written; unchanged
#   copy-failed    vendored: replacing the copy failed; restored from this run's
#                  backup (left at <dir>.bak if even that failed)
#   setup-failed   ./setup exited non-zero. git: the new version is on disk and
#                  needs `./setup` run there; vendored: restored to <old>
# --plan prints plan:<git|vendored>:<would-upgrade|up-to-date|would-fail-not-writable>.
# The writability verdict comes from a probe, never from parsing error text:
# --plan asks `test -w` (mutates nothing); a real run creates and removes a
# temporary file in each directory, since some sandboxes refuse the write
# without changing what `test -w` reports.
#
# Exit: 0 ok · 2 remote unreachable · 3 one or more copies failed
#
# Env overrides (testing):
#   PLN_SKILL_DIRS   explicit space-separated dir list (default: enumerate)
#   PLN_REMOTE_URL   remote VERSION url
#   PLN_SOURCE_REPO  git URL/path to clone for vendored copies
#   PLN_SOURCE_DIR   local dir to copy for vendored copies (skips clone)
#   PLN_STATE_DIR    ~/.pln state dir (marker + cache)
#   PLN_NO_SETUP=1   skip ./setup after each upgrade
set -uo pipefail

REMOTE_URL="${PLN_REMOTE_URL:-https://raw.githubusercontent.com/daniel-nelson/pln/main/VERSION}"
SOURCE_REPO="${PLN_SOURCE_REPO:-https://github.com/daniel-nelson/pln.git}"
STATE_DIR="${PLN_STATE_DIR:-$HOME/.pln}"

PLAN=false
[ "${1:-}" = "--plan" ] && PLAN=true

disp() { case "$1" in "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }

ver_lt() {
  [ "$1" = "$2" ] && return 1
  local IFS=. i max
  local -a A=($1) B=($2)
  max=${#A[@]}
  [ ${#B[@]} -gt "$max" ] && max=${#B[@]}
  for ((i = 0; i < max; i++)); do
    local ai="${A[i]:-0}" bi="${B[i]:-0}"
    ai="${ai%%[!0-9]*}"; bi="${bi%%[!0-9]*}"
    ai="${ai:-0}"; bi="${bi:-0}"
    if [ "$ai" -lt "$bi" ]; then return 0; fi
    if [ "$ai" -gt "$bi" ]; then return 1; fi
  done
  return 1
}

list_install_dirs() {
  if [ -n "${PLN_SKILL_DIRS:-}" ]; then
    printf '%s\n' $PLN_SKILL_DIRS
    return
  fi
  local candidates=(
    "$HOME/.agents/skills/pln"
    "$HOME/.claude/skills/pln"
    ".agents/skills/pln"
    ".claude/skills/pln"
  )
  local seen="" d rp
  for d in "${candidates[@]}"; do
    [ -n "$d" ] || continue
    [ -e "$d" ] || [ -L "$d" ] || continue
    rp="$(cd "$d" 2>/dev/null && pwd -P)" || rp="$d"   # keep symlinks by literal path
    [ -L "$d" ] && rp="$d"
    case ":$seen:" in *":$rp:"*) continue ;; esac
    seen="$seen:$rp"
    printf '%s\n' "$rp"
  done
}

read_ver() { tr -d '[:space:]' < "$1/VERSION" 2>/dev/null || echo unknown; }

# ─── One-time .codex → .agents consolidation ─────────────────
# Codex now reads .agents. Move any legacy .codex pln copy into the
# matching .agents location when none exists there, or drop it when an .agents
# copy already does. Dev symlinks are never touched (mirrors the guard below).
# Idempotent: a no-op once .codex is gone. Under --plan, reports without mutating.
migrate_codex_to_agents() {
  local pair codex agents
  local -a pairs=(
    "$HOME/.codex/skills/pln|$HOME/.agents/skills/pln"
    ".codex/skills/pln|.agents/skills/pln"
  )
  for pair in "${pairs[@]}"; do
    codex="${pair%%|*}"
    agents="${pair##*|}"
    [ -e "$codex" ] || [ -L "$codex" ] || continue
    if [ -L "$codex" ]; then
      echo "MIGRATE $(disp "$codex") dev-symlink-skipped"
      continue
    fi
    if [ -e "$agents" ] || [ -L "$agents" ]; then
      if $PLAN; then
        echo "MIGRATE $(disp "$codex") plan:drop (.agents copy exists)"
      else
        rm -rf "$codex" 2>/dev/null || true
        if [ -e "$codex" ] || [ -L "$codex" ]; then
          echo "MIGRATE $(disp "$codex") drop-failed"
        else
          echo "MIGRATE $(disp "$codex") dropped (.agents copy exists)"
        fi
      fi
    else
      if $PLAN; then
        echo "MIGRATE $(disp "$codex") plan:move -> $(disp "$agents")"
      else
        mkdir -p "$(dirname "$agents")" 2>/dev/null || true
        if mv "$codex" "$agents" 2>/dev/null; then
          echo "MIGRATE $(disp "$codex") -> $(disp "$agents") moved"
        else
          echo "MIGRATE $(disp "$codex") move-failed"
        fi
      fi
    fi
  done
}

# ─── Fetch + validate remote version ─────────────────────────
REMOTE="$(curl -sf --max-time 10 "$REMOTE_URL" 2>/dev/null | tr -d '[:space:]' || true)"
if ! echo "$REMOTE" | grep -qE '^[0-9]+\.[0-9.]+$'; then
  echo "ERROR could not reach remote ($REMOTE_URL)"
  exit 2
fi
echo "REMOTE $REMOTE"

# ─── Consolidate legacy .codex copies into .agents ───────────
migrate_codex_to_agents

# ─── Lazy source clone (only needed for vendored copies) ─────
SRC=""
TMP_CLONE=""
ensure_src() {
  [ -n "$SRC" ] && return 0
  if [ -n "${PLN_SOURCE_DIR:-}" ]; then
    SRC="$PLN_SOURCE_DIR"
    return 0
  fi
  TMP_CLONE="$(mktemp -d)"
  if git clone --depth 1 "$SOURCE_REPO" "$TMP_CLONE/pln" >/dev/null 2>&1; then
    SRC="$TMP_CLONE/pln"
    return 0
  fi
  return 1
}
PROBE=""
cleanup() {
  [ -n "$TMP_CLONE" ] && rm -rf "$TMP_CLONE" 2>/dev/null
  [ -n "$PROBE" ] && rm -f "$PROBE" 2>/dev/null
  return 0
}
trap cleanup EXIT

run_setup() { [ "${PLN_NO_SETUP:-}" = "1" ] && return 0; ( cd "$1" && ./setup >/dev/null 2>&1 ); }

# can_write <dir>... — true when every dir accepts a write. See the header for
# why a real run writes instead of asking `test -w`.
can_write() {
  local d
  for d in "$@"; do
    if $PLAN; then
      [ -w "$d" ] || return 1
      continue
    fi
    PROBE="$(mktemp "$d/.pln-write-probe.XXXXXX" 2>/dev/null)" || { PROBE=""; return 1; }
    rm -f "$PROBE" 2>/dev/null
    PROBE=""
  done
  return 0
}

# fail_copy <dir> <old> <reason> — report a copy that did not upgrade.
fail_copy() {
  echo "COPY $(disp "$1") $2 -> $(read_ver "$1") failed:$3"
  FAIL=$((FAIL + 1))
}

UP=0; UNCH=0; SKIP=0; FAIL=0; UPDIRS=""
OLDMIN=""

while IFS= read -r dir; do
  [ -n "$dir" ] || continue
  old="$(read_ver "$dir")"
  [ "$old" != "unknown" ] && { [ -z "$OLDMIN" ] || ver_lt "$old" "$OLDMIN"; } && OLDMIN="$old"

  # Dev symlink → never touch; the developer git-pulls the source clone.
  if [ -L "$dir" ]; then
    echo "COPY $(disp "$dir") $old -> $old dev-symlink-skipped"
    SKIP=$((SKIP + 1))
    continue
  fi

  is_git=false
  [ -d "$dir/.git" ] && is_git=true

  # Probe before anything is mutated: git writes the worktree and .git; a
  # vendored copy is backed up beside itself, so its parent must take writes too.
  if $is_git; then
    can_write "$dir" "$dir/.git" && writable=true || writable=false
  else
    can_write "$dir" "$(dirname "$dir")" && writable=true || writable=false
  fi

  if $PLAN; then
    if ! $writable; then act="would-fail-not-writable"
    elif ver_lt "$old" "$REMOTE"; then act="would-upgrade"; else act="up-to-date"; fi
    $is_git && kind=git || kind=vendored
    echo "COPY $(disp "$dir") $old -> $REMOTE plan:$kind:$act"
    continue
  fi

  if ! $writable; then
    fail_copy "$dir" "$old" not-writable
    continue
  fi

  status=""
  if $is_git; then
    # Fetch first: it leaves the worktree alone, so a network failure leaves
    # the copy exactly as built rather than half-cleaned.
    if ! git -C "$dir" fetch origin >/dev/null 2>&1; then
      fail_copy "$dir" "$old" fetch-failed
      continue
    fi
    # The skill files are generated at install time, so every install has them
    # modified against HEAD. Put them back first, or the stash below fires on
    # every single upgrade and reports the user's copy as "stashed".
    [ -x "$dir/bin/pln-generate" ] && "$dir/bin/pln-generate" --clean >/dev/null 2>&1
    stash_out="$(git -C "$dir" stash 2>&1)"
    case "$stash_out" in *"Saved working directory"*) status="stashed" ;; esac
    if ! git -C "$dir" reset --hard origin/main >/dev/null 2>&1; then
      run_setup "$dir" || true   # rebuild what --clean put back; best effort
      fail_copy "$dir" "$old" reset-failed
      continue
    fi
    if ! run_setup "$dir"; then
      fail_copy "$dir" "$old" setup-failed
      continue
    fi
  else
    if ! ensure_src; then
      fail_copy "$dir" "$old" clone-failed
      continue
    fi
    # Only a backup this run made is ever restored. A leftover .bak that will
    # not go away stops the upgrade before the copy is touched, and a backup
    # that fails to write is removed, never followed by removing the copy.
    rm -rf "$dir.bak" 2>/dev/null
    if [ -e "$dir.bak" ] || [ -L "$dir.bak" ]; then
      fail_copy "$dir" "$old" backup-failed
      continue
    fi
    if ! cp -R "$dir" "$dir.bak" 2>/dev/null; then
      rm -rf "$dir.bak" 2>/dev/null
      fail_copy "$dir" "$old" backup-failed
      continue
    fi
    reason=""
    if ! { rm -rf "$dir" 2>/dev/null && cp -R "$SRC" "$dir" 2>/dev/null; }; then
      reason=copy-failed
    elif ! run_setup "$dir"; then
      reason=setup-failed
    fi
    if [ -n "$reason" ]; then
      rm -rf "$dir" 2>/dev/null
      [ -e "$dir" ] || mv "$dir.bak" "$dir" 2>/dev/null
      fail_copy "$dir" "$old" "$reason"
      continue
    fi
    rm -rf "$dir.bak" 2>/dev/null || true
  fi

  new="$(read_ver "$dir")"
  if [ "$new" = "$old" ]; then
    echo "COPY $(disp "$dir") $old -> $new unchanged"
    UNCH=$((UNCH + 1))
  else
    echo "COPY $(disp "$dir") $old -> $new ${status:-upgraded}"
    UP=$((UP + 1))
    UPDIRS="${UPDIRS:+$UPDIRS, }$(disp "$dir")"
  fi
done < <(list_install_dirs)

[ -z "$OLDMIN" ] && OLDMIN="unknown"
echo "SUMMARY $OLDMIN -> $REMOTE ($UP upgraded, $UNCH unchanged, $SKIP skipped, $FAIL failed)"

# Write the just-upgraded marker + clear caches only on a real run that changed something.
if ! $PLAN && [ "$UP" -gt 0 ]; then
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  # The marker is one file shared by every install, so it records who wrote it:
  # without that, whichever host reads it first reports another install's
  # upgrade as its own. Second field onward is free text for a human.
  printf '%s %s\n' "$OLDMIN" "$UPDIRS" > "$STATE_DIR/just-upgraded-from" 2>/dev/null || true
  rm -f "$STATE_DIR/last-update-check" "$STATE_DIR/update-snoozed" 2>/dev/null || true
fi

[ "$FAIL" -gt 0 ] && exit 3
exit 0
