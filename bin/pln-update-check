#!/usr/bin/env bash
# pln-update-check — periodic version check, run from the SKILL.md preamble.
#
# Output (one line, or nothing):
#   JUST_UPGRADED <old> <new>       — marker found from a recent upgrade
#   UPGRADE_AVAILABLE <old> <new>   — some installed copy is behind remote
#   (nothing)                       — up to date, snoozed, disabled, or check skipped
#
# On the slow path an UPGRADE_AVAILABLE line may be followed by an indented
# per-copy detail line (which dir is behind), for the human to see. The first
# token of the first line is always the machine-readable verdict.
#
# This script scans EVERY installed copy of pln (not just its own directory) and
# reports UPGRADE_AVAILABLE if ANY copy is behind remote. This is deliberate:
# pln can be installed in several roots at once (~/.agents, ~/.claude, plus
# project-local variants) and the host may load a different copy than the one
# that sorts first. A single copy scanned in isolation hid staleness before.
#
# Env overrides (for testing):
#   PLN_SKILL_DIR        — single-dir mode: scan ONLY this dir (also locates bin/)
#   PLN_SKILL_DIRS       — explicit space-separated dir list to scan
#   PLN_REMOTE_URL       — override remote VERSION URL
#   PLN_STATE_DIR        — override ~/.pln state directory
set -euo pipefail

SELF_DIR="${PLN_SKILL_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
STATE_DIR="${PLN_STATE_DIR:-$HOME/.pln}"
CACHE_FILE="$STATE_DIR/last-update-check"
MARKER_FILE="$STATE_DIR/just-upgraded-from"
SNOOZE_FILE="$STATE_DIR/update-snoozed"
REMOTE_URL="${PLN_REMOTE_URL:-https://raw.githubusercontent.com/daniel-nelson/pln/main/VERSION}"

# ─── Force flag (busts cache + snooze for standalone /pln-update) ────────────
FORCE_CHECK=false
if [ "${1:-}" = "--force" ]; then
  FORCE_CHECK=true
  rm -f "$CACHE_FILE" 2>/dev/null || true
  rm -f "$SNOOZE_FILE" 2>/dev/null || true
fi

# ─── Step 0: Check if updates are disabled ────────────────────
_UC=$("$SELF_DIR/bin/pln-config" get update_check 2>/dev/null || true)
if [ "$_UC" = "false" ]; then
  exit 0
fi

# ─── Install-dir enumeration ─────────────────────────────────
# Echo one absolute path per existing install copy, deduplicated by realpath.
list_install_dirs() {
  if [ -n "${PLN_SKILL_DIRS:-}" ]; then
    printf '%s\n' $PLN_SKILL_DIRS
    return
  fi
  if [ -n "${PLN_SKILL_DIR:-}" ]; then
    printf '%s\n' "$PLN_SKILL_DIR"
    return
  fi
  local candidates=(
    "${CLAUDE_SKILL_DIR:-}"
    "$HOME/.agents/skills/pln"
    "$HOME/.claude/skills/pln"
    ".agents/skills/pln"
    ".claude/skills/pln"
  )
  local seen="" d rp
  for d in "${candidates[@]}"; do
    [ -n "$d" ] || continue
    [ -d "$d" ] || continue
    rp="$(cd "$d" 2>/dev/null && pwd -P)" || continue
    case ":$seen:" in *":$rp:"*) continue ;; esac
    seen="$seen:$rp"
    printf '%s\n' "$rp"
  done
}

# ver_lt A B → return 0 (true) if version A is strictly less than B.
ver_lt() {
  [ "$1" = "$2" ] && return 1
  local IFS=. i max
  local -a A=($1) B=($2)
  max=${#A[@]}
  [ ${#B[@]} -gt "$max" ] && max=${#B[@]}
  for ((i = 0; i < max; i++)); do
    local ai="${A[i]:-0}" bi="${B[i]:-0}"
    ai="${ai%%[!0-9]*}"; bi="${bi%%[!0-9]*}"
    ai="${ai:-0}"; bi="${bi:-0}"
    if [ "$ai" -lt "$bi" ]; then return 0; fi
    if [ "$ai" -gt "$bi" ]; then return 1; fi
  done
  return 1
}

# Pretty path for humans: collapse $HOME to ~.
disp() { case "$1" in "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }

# ─── Step 1: Read local versions — LOCAL is the LOWEST across all copies ──────
LOCAL=""
DIRS=()
VERS=()
while IFS= read -r dir; do
  [ -n "$dir" ] || continue
  v=""
  [ -f "$dir/VERSION" ] && v="$(tr -d '[:space:]' < "$dir/VERSION" 2>/dev/null || true)"
  [ -n "$v" ] || v="0"          # missing/unreadable VERSION → treat as behind
  DIRS+=("$dir")
  VERS+=("$v")
  if [ -z "$LOCAL" ] || ver_lt "$v" "$LOCAL"; then LOCAL="$v"; fi
done < <(list_install_dirs)

if [ -z "$LOCAL" ]; then
  exit 0  # No install copy found → skip check
fi

# build_detail <remote> — echo an indented "which copies are behind" line.
build_detail() {
  local remote="$1" i out=""
  for i in "${!DIRS[@]}"; do
    local tag=""
    ver_lt "${VERS[i]}" "$remote" && tag=" (behind)"
    out="$out · $(disp "${DIRS[i]}") ${VERS[i]}$tag"
  done
  [ -n "$out" ] && printf '  %s\n' "${out# · }"
}

# ─── Step 2: Check "just upgraded" marker ─────────────────────
# The marker records an upgrade that already happened. On a passive check that
# is the whole answer and the run stops here. On `--force` it is not: the user
# asked this question deliberately, and answering it out of a file written
# before they asked means an explicit update immediately after an automatic one
# never contacts the remote at all — it reports the earlier upgrade, writes an
# hour of `UP_TO_DATE` into the cache, and looks like it succeeded. So a forced
# check consumes the marker, remembers it, and carries on to the fetch.
#
# The marker is one file shared by every install, so it also records which
# install wrote it. A marker another install wrote is reported as that
# install's upgrade rather than claimed as this one's.
JUST_UPGRADED_FROM=""
JUST_UPGRADED_BY=""
if [ -f "$MARKER_FILE" ]; then
  MARKER_RAW="$(cat "$MARKER_FILE" 2>/dev/null || true)"
  OLD="$(printf '%s' "$MARKER_RAW" | awk 'NR==1{print $1}' | tr -d '[:space:]')"
  BY="$(printf '%s' "$MARKER_RAW" | awk 'NR==1{$1=""; sub(/^ /, ""); print}')"
  rm -f "$MARKER_FILE" 2>/dev/null || true
  rm -f "$SNOOZE_FILE" 2>/dev/null || true
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  if [ "$FORCE_CHECK" != "true" ]; then
    echo "UP_TO_DATE $LOCAL" > "$CACHE_FILE" 2>/dev/null || true
    if [ -n "$OLD" ]; then
      echo "JUST_UPGRADED $OLD $LOCAL"
      [ -n "$BY" ] && printf '  upgraded by %s\n' "$BY"
    fi
    exit 0
  fi
  JUST_UPGRADED_FROM="$OLD"
  JUST_UPGRADED_BY="$BY"
fi

# ─── Snooze helper ──────────────────────────────────────────
# check_snooze <remote_version>
#   Returns 0 if snoozed (should stay quiet), 1 if not snoozed (should output).
#
#   Snooze file format: <version> <level> <epoch>
#   Level durations: 1=24h, 2=48h, 3+=7d
#   New version (version mismatch) resets snooze.
check_snooze() {
  if [ "$FORCE_CHECK" = "true" ]; then
    return 1
  fi

  local remote_ver="$1"
  if [ ! -f "$SNOOZE_FILE" ]; then
    return 1  # no snooze file → not snoozed
  fi
  local snoozed_ver snoozed_level snoozed_epoch
  snoozed_ver="$(awk '{print $1}' "$SNOOZE_FILE" 2>/dev/null || true)"
  snoozed_level="$(awk '{print $2}' "$SNOOZE_FILE" 2>/dev/null || true)"
  snoozed_epoch="$(awk '{print $3}' "$SNOOZE_FILE" 2>/dev/null || true)"

  # Validate: all three fields must be non-empty
  if [ -z "$snoozed_ver" ] || [ -z "$snoozed_level" ] || [ -z "$snoozed_epoch" ]; then
    return 1  # corrupt file → not snoozed
  fi

  # Validate: level and epoch must be integers
  case "$snoozed_level" in *[!0-9]*) return 1 ;; esac
  case "$snoozed_epoch" in *[!0-9]*) return 1 ;; esac

  # New version dropped? Ignore snooze.
  if [ "$snoozed_ver" != "$remote_ver" ]; then
    return 1
  fi

  # Compute snooze duration based on level
  local duration
  case "$snoozed_level" in
    1) duration=86400 ;;   # 24 hours
    2) duration=172800 ;;  # 48 hours
    *) duration=604800 ;;  # 7 days (level 3+)
  esac

  local now
  now="$(date +%s)"
  local expires=$(( snoozed_epoch + duration ))
  if [ "$now" -lt "$expires" ]; then
    return 0  # still snoozed
  fi

  return 1  # snooze expired
}

# ─── Step 3: Check cache freshness ──────────────────────────
# UP_TO_DATE: 60 min TTL (detect new releases quickly)
# UPGRADE_AVAILABLE: 720 min TTL (keep nagging)
if [ "$FORCE_CHECK" != "true" ] && [ -f "$CACHE_FILE" ]; then
  CACHED="$(cat "$CACHE_FILE" 2>/dev/null || true)"
  case "$CACHED" in
    UP_TO_DATE*)        CACHE_TTL=60 ;;
    UPGRADE_AVAILABLE*) CACHE_TTL=720 ;;
    *)                  CACHE_TTL=0 ;;  # corrupt → force re-fetch
  esac

  STALE=$(find "$CACHE_FILE" -mmin +$CACHE_TTL 2>/dev/null || true)
  if [ -z "$STALE" ] && [ "$CACHE_TTL" -gt 0 ]; then
    case "$CACHED" in
      UP_TO_DATE*)
        CACHED_VER="$(echo "$CACHED" | awk '{print $2}')"
        if [ "$CACHED_VER" = "$LOCAL" ]; then
          exit 0
        fi
        ;;
      UPGRADE_AVAILABLE*)
        CACHED_OLD="$(echo "$CACHED" | awk '{print $2}')"
        if [ "$CACHED_OLD" = "$LOCAL" ]; then
          CACHED_NEW="$(echo "$CACHED" | awk '{print $3}')"
          if check_snooze "$CACHED_NEW"; then
            exit 0  # snoozed — stay quiet
          fi
          echo "$CACHED"
          build_detail "$CACHED_NEW"
          exit 0
        fi
        ;;
    esac
  fi
fi

# ─── Step 4: Slow path — fetch remote version ────────────────
mkdir -p "$STATE_DIR" 2>/dev/null || true

# `raw.githubusercontent.com` serves `cache-control: max-age=300` from a Fastly
# edge, and the path `.../main/VERSION` is *mutable*: the same URL means a
# different file after every merge. So a plain fetch can answer with the
# version from up to five minutes ago, and a release merged and immediately
# asked for comes back as the previous one — which is not how the same
# repository behaves under `git pull`, and is the whole of why that expectation
# is reasonable. Asking the edge politely does not help: a client
# `Cache-Control: no-cache` and a varied query string were both tried in
# 1.55.0, and a check 21 seconds after a merge still returned the old version.
#
# So a forced check stops trusting the mutable path. `git ls-remote` reads the
# ref from GitHub's git endpoint, which is not edge-cached — that is why a
# `git pull` is never behind — and the sha it returns names an *immutable* raw
# path, where a cached copy can only be the right one. Two round trips, on a
# check the user explicitly asked for.
#
# Every part of this degrades to the old behavior rather than failing: no git,
# an unparseable URL, a failed `ls-remote`, or a fetch that returns nothing all
# fall back to the plain URL. The passive check keeps the plain URL always,
# where a five-minute-old answer costs nothing.

# The ref-resolving path is specific to `raw.githubusercontent.com`, whose URL
# shape is `https://raw.githubusercontent.com/<owner>/<repo>/<ref>/<path...>`.
# Any other remote — the `PLN_REMOTE_URL` test override, a mirror, a fork
# served elsewhere — takes the plain fetch unchanged.
RAW_HOST_PREFIX='https://raw.githubusercontent.com/'

# raw_parts <url> — prints "<owner> <repo> <ref> <path...>", or nothing.
raw_parts() {
  case "$1" in
    "$RAW_HOST_PREFIX"*) ;;
    *) return 0 ;;
  esac
  printf '%s' "${1#"$RAW_HOST_PREFIX"}" | LC_ALL=C awk -F/ '
    NF < 4 { exit }
    { rest = $4; for (i = 5; i <= NF; i++) rest = rest "/" $i
      printf "%s %s %s %s\n", $1, $2, $3, rest }
  '
}

REMOTE=""
FETCH_URL="$REMOTE_URL"
if [ "$FORCE_CHECK" = "true" ] && command -v git >/dev/null 2>&1; then
  PARTS="$(raw_parts "$REMOTE_URL")"
  if [ -n "$PARTS" ]; then
    R_OWNER="$(printf '%s' "$PARTS" | LC_ALL=C cut -d' ' -f1)"
    R_REPO="$(printf '%s' "$PARTS" | LC_ALL=C cut -d' ' -f2)"
    R_REF="$(printf '%s' "$PARTS" | LC_ALL=C cut -d' ' -f3)"
    R_PATH="$(printf '%s' "$PARTS" | LC_ALL=C cut -d' ' -f4-)"
    SHA="$(git ls-remote "https://github.com/$R_OWNER/$R_REPO" "refs/heads/$R_REF" 2>/dev/null \
           | LC_ALL=C cut -f1 | head -1)"
    case "$SHA" in
      [0-9a-f][0-9a-f][0-9a-f][0-9a-f]*)
        FETCH_URL="$RAW_HOST_PREFIX$R_OWNER/$R_REPO/$SHA/$R_PATH" ;;
    esac
  fi
fi
REMOTE="$(curl -sf --max-time 5 "$FETCH_URL" 2>/dev/null || true)"
if [ -z "$REMOTE" ] && [ "$FETCH_URL" != "$REMOTE_URL" ]; then
  # A pinned path that returns nothing is a resolution problem, not a verdict.
  REMOTE="$(curl -sf --max-time 5 "$REMOTE_URL" 2>/dev/null || true)"
fi
REMOTE="$(echo "$REMOTE" | tr -d '[:space:]')"

# A forced check that consumed a marker still owes the user that news, whatever
# the fetch then says. It is printed before the verdict, because "you are on
# 1.54.0" is the answer and "you got here from 1.53.0" is the context for it.
report_marker() {
  [ -n "$JUST_UPGRADED_FROM" ] || return 0
  echo "JUST_UPGRADED $JUST_UPGRADED_FROM $LOCAL"
  [ -n "$JUST_UPGRADED_BY" ] && printf '  upgraded by %s\n' "$JUST_UPGRADED_BY"
  return 0
}

# Validate: must look like a version number (reject HTML error pages)
if ! echo "$REMOTE" | grep -qE '^[0-9]+\.[0-9.]+$'; then
  # Invalid or empty response — assume up to date
  echo "UP_TO_DATE $LOCAL" > "$CACHE_FILE" 2>/dev/null || true
  report_marker
  exit 0
fi

# Any installed copy behind remote? (LOCAL is the lowest across all copies.)
if ! ver_lt "$LOCAL" "$REMOTE"; then
  echo "UP_TO_DATE $LOCAL" > "$CACHE_FILE" 2>/dev/null || true
  report_marker
  exit 0
fi

# Some copy is behind — upgrade available.
echo "UPGRADE_AVAILABLE $LOCAL $REMOTE" > "$CACHE_FILE" 2>/dev/null || true
if check_snooze "$REMOTE"; then
  report_marker
  exit 0  # snoozed — stay quiet
fi

report_marker
echo "UPGRADE_AVAILABLE $LOCAL $REMOTE"
build_detail "$REMOTE"
