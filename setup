#!/usr/bin/env bash
set -e

SKILL_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$(dirname "$SKILL_DIR")"

echo "Setting up pln..."

linked=0
skipped=0

for subdir in "$SKILL_DIR"/*/; do
  [ -f "$subdir/SKILL.md" ] || continue
  name="$(basename "$subdir")"
  target="$SKILLS_DIR/$name"

  if [ -L "$target" ] || [ -e "$target" ]; then
    echo "  skipping /$name — already exists at $target"
    skipped=$((skipped + 1))
  else
    ln -s "$subdir" "$target"
    echo "  linked /$name → $target"
    linked=$((linked + 1))
  fi
done

echo ""
echo "Done. Skills available:"
echo "  /pln        — two-phase planning: interview all items, then implement one at a time"
echo "  /pln-pr     — review the current branch and open a pull request, the pln way"
echo "  /plnify     — install pln's discipline into your CLAUDE.md for a skill suite"
echo "  /pln-update — update pln to the latest version"
echo ""
echo "Restart Claude Code to pick up the new skills."

# Optional, opt-in: offer the /pln-pr routing rule (one-time). This does NOT
# write anything — it prints an agent-directed offer + a preview, and the
# installing agent conducts the ask. Gated so it's offered once.
_PROMPTED="$("$SKILL_DIR/bin/pln-config" get routing_prompted 2>/dev/null || true)"
if [ "$_PROMPTED" != "true" ]; then
  _PLAN="$("$SKILL_DIR/bin/pln-routing-rule" --plan 2>/dev/null || true)"
  case "$_PLAN" in
    *"RESULT: plan:add"*)
      echo ""
      echo "=== OPTIONAL (agent: ask the user before doing anything) ==="
      echo "/pln-pr works best when PR requests route through it. A compound"
      echo "instruction like \"bump the version and open the PR\" can otherwise"
      echo "bypass the review army. I can add a short routing rule to the user's"
      echo "global instructions (preview below) so those requests route to /pln-pr."
      echo ""
      echo "$_PLAN"
      echo ""
      echo "AGENT: ask the user whether to add this rule."
      echo "  - On YES: run  $SKILL_DIR/bin/pln-routing-rule"
      echo "            then  $SKILL_DIR/bin/pln-config set routing_prompted true"
      echo "  - On NO:  run  $SKILL_DIR/bin/pln-config set routing_prompted true"
      echo "=== END OPTIONAL ==="
      ;;
  esac
fi
