#!/usr/bin/env bash
set -e

SKILL_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$(dirname "$SKILL_DIR")"

echo "Setting up pln..."

# ─── Build the host-specific skill files ─────────────────────
# The skills say different things on Claude Code and on Codex, and the copy a
# model reads must contain only its own host's mechanics. The host comes from
# the install path (each host gets its own clone), so there is nothing to ask.
HOST="$("$SKILL_DIR/bin/pln-host" "$SKILL_DIR")"
"$SKILL_DIR/bin/pln-generate" "$HOST"

# One clone cannot serve both hosts: a single generated file would be wrong for
# one of them. This catches the case where a host's skills dir is a symlink to
# the other's clone rather than a clone of its own.
_seen=""
for root in "$HOME/.claude/skills/pln" "$HOME/.agents/skills/pln" "$HOME/.codex/skills/pln"; do
  [ -e "$root" ] || continue
  rp="$(cd "$root" 2>/dev/null && pwd -P)" || continue
  case ":$_seen:" in
    *":$rp:"*)
      echo ""
      echo "  WARNING: more than one host install resolves to $rp."
      echo "  The generated skill files can only match one host at a time — give each"
      echo "  host its own clone instead of pointing one at the other."
      ;;
    *) _seen="$_seen:$rp" ;;
  esac
done

linked=0
skipped=0

for subdir in "$SKILL_DIR"/*/; do
  [ -f "$subdir/SKILL.md" ] || continue
  name="$(basename "$subdir")"
  target="$SKILLS_DIR/$name"

  if [ -L "$target" ] || [ -e "$target" ]; then
    echo "  skipping /$name — already exists at $target"
    skipped=$((skipped + 1))
  else
    ln -s "$subdir" "$target"
    echo "  linked /$name → $target"
    linked=$((linked + 1))
  fi
done

echo ""
echo "Done. Skills available:"
echo "  /pln        — two-phase planning: interview all items, then implement one at a time"
echo "  /pln-pr     — review the current branch and open a pull request, the pln way"
echo "  /pln-update — update pln to the latest version"
echo ""
case "$HOST" in
  codex) echo "Built for Codex. Restart Codex to pick up the new skills." ;;
  *) echo "Built for Claude Code. Restart Claude Code to pick up the new skills." ;;
esac

# ─── One-time peer / cross-model check nudge ─────────────────
# pln can send a plan or PR diff to a second model for review, but that only
# happens when a peer CLI is actually reachable. Tell a user who has none
# how to get one, once — not on every /pln run.
if [ "$("$SKILL_DIR/bin/pln-config" get peer_nudge_shown 2>/dev/null)" != "true" ]; then
  set +e
  PEER_WHICH="$("$SKILL_DIR/bin/pln-peer" --which --host "$HOST" 2>/dev/null)"
  PEER_RC=$?
  set -e
  PEER_RUNG="$(printf '%s\n' "$PEER_WHICH" | sed -n 's/^RUNG=//p')"
  PEER_STATUS="$(printf '%s\n' "$PEER_WHICH" | sed -n 's/^STATUS=//p')"

  if [ "$PEER_RC" -eq 3 ] && [ "$PEER_RUNG" = "3" ] && [ "$PEER_STATUS" = "none" ]; then
    # Nothing usable was found — this also covers a known CLI on PATH that
    # isn't signed in, so don't claim it's simply not installed.
    case "$HOST" in
      codex) PEER_CLI="claude" ;;
      *) PEER_CLI="codex" ;;
    esac
    echo ""
    echo "Tip: pln can get a cross-model check on plans and PRs from a peer CLI."
    echo "  None was found installed and signed in. Install and sign in to $PEER_CLI,"
    echo "  or point pln at another one:"
    echo "  \"$SKILL_DIR/bin/pln-config\" set peer_command \"<invocation>\""
  else
    # Ready, consent-pending, or already declined — all settled states that
    # don't need re-checking on the next setup run.
    "$SKILL_DIR/bin/pln-config" set peer_nudge_shown true >/dev/null
  fi
fi
