#!/usr/bin/env bash
set -e

SKILL_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$(dirname "$SKILL_DIR")"

echo "Setting up pln..."

# ─── Build the host-specific skill files ─────────────────────
# The skills say different things on Claude Code and on Codex, and the copy a
# model reads must contain only its own host's mechanics. The host comes from
# the install path (each host gets its own clone), so there is nothing to ask.
HOST="$("$SKILL_DIR/bin/pln-host" "$SKILL_DIR")"
"$SKILL_DIR/bin/pln-generate" "$HOST"

# One clone cannot serve both hosts: a single generated file would be wrong for
# one of them. This catches the case where a host's skills dir is a symlink to
# the other's clone rather than a clone of its own.
_seen=""
for root in "$HOME/.claude/skills/pln" "$HOME/.agents/skills/pln" "$HOME/.codex/skills/pln"; do
  [ -e "$root" ] || continue
  rp="$(cd "$root" 2>/dev/null && pwd -P)" || continue
  case ":$_seen:" in
    *":$rp:"*)
      echo ""
      echo "  WARNING: more than one host install resolves to $rp."
      echo "  The generated skill files can only match one host at a time — give each"
      echo "  host its own clone instead of pointing one at the other."
      ;;
    *) _seen="$_seen:$rp" ;;
  esac
done

linked=0
skipped=0

for subdir in "$SKILL_DIR"/*/; do
  [ -f "$subdir/SKILL.md" ] || continue
  name="$(basename "$subdir")"
  target="$SKILLS_DIR/$name"

  if [ -L "$target" ] || [ -e "$target" ]; then
    echo "  skipping /$name — already exists at $target"
    skipped=$((skipped + 1))
  else
    ln -s "$subdir" "$target"
    echo "  linked /$name → $target"
    linked=$((linked + 1))
  fi
done

echo ""
echo "Done. Skills available:"
echo "  /pln        — two-phase planning, then dependency-aware implementation"
echo "  /pln-pr     — review the current branch and open a pull request, the pln way"
echo "  /pln-simplify — map and safely simplify a codebase"
echo "  /pln-update — update pln to the latest version"
echo ""
case "$HOST" in
  codex) echo "Built for Codex. Restart Codex to pick up the new skills." ;;
  *) echo "Built for Claude Code. Restart Claude Code to pick up the new skills." ;;
esac

# ─── One-time optional economy-evidence nudge ───────────────
# This is setup-time discoverability only. `/pln` never interrupts an
# interview to advertise it, and an older host without usable model/effort
# controls gets a clean no-op so setup remains portable.
if [ "$("$SKILL_DIR/bin/pln-config" get economy_nudge_shown 2>/dev/null)" != "true" ] \
  && [ -x "$SKILL_DIR/bin/pln-model-route" ]; then
  set +e
  ECONOMY_ROUTE="$("$SKILL_DIR/bin/pln-model-route" probe --host "$HOST" 2>/dev/null)"
  ECONOMY_RC=$?
  set -e
  ECONOMY_STATUS="$(printf '%s\n' "$ECONOMY_ROUTE" | sed -n 's/^STATUS=//p')"
  if [ "$ECONOMY_RC" -eq 0 ] && [ "$ECONOMY_STATUS" = "available" ]; then
    echo ""
    echo "Optional: pln can route only bounded fact-and-citation collection to a lower-cost model."
    echo "  Same-host work currently inherits your selected model; implementation, review, and"
    echo "  user-facing decisions always stay on the judgment profile. Enable the narrow lane with:"
    echo "  \"$SKILL_DIR/bin/pln-config\" set evidence_profile economy"
    "$SKILL_DIR/bin/pln-config" set economy_nudge_shown true >/dev/null
  fi
fi

# ─── One-time peer / cross-model check nudge ─────────────────
# pln can send a plan or PR diff to a second model for review, but that only
# happens when a peer CLI is actually reachable. Tell a user who has none
# how to get one, once — not on every /pln run.
if [ "$("$SKILL_DIR/bin/pln-config" get peer_nudge_shown 2>/dev/null)" != "true" ]; then
  set +e
  PEER_WHICH="$("$SKILL_DIR/bin/pln-peer" --which --host "$HOST" 2>/dev/null)"
  PEER_RC=$?
  set -e
  PEER_RUNG="$(printf '%s\n' "$PEER_WHICH" | sed -n 's/^RUNG=//p')"
  PEER_STATUS="$(printf '%s\n' "$PEER_WHICH" | sed -n 's/^STATUS=//p')"

  if [ "$PEER_RC" -eq 3 ] && [ "$PEER_RUNG" = "3" ] && [ "$PEER_STATUS" = "none" ]; then
    # Nothing usable was found — this also covers a known CLI on PATH that
    # isn't signed in, so don't claim it's simply not installed.
    case "$HOST" in
      codex) PEER_CLI="claude" ;;
      *) PEER_CLI="codex" ;;
    esac
    echo ""
    echo "Tip: pln can get a cross-model check on plans and PRs from a peer CLI."
    echo "  None was found installed and signed in. Install and sign in to $PEER_CLI,"
    echo "  or point pln at another one:"
    echo "  \"$SKILL_DIR/bin/pln-config\" set peer_command \"<invocation>\""
  else
    # Ready, consent-pending, or already declined — all settled states that
    # don't need re-checking on the next setup run.
    "$SKILL_DIR/bin/pln-config" set peer_nudge_shown true >/dev/null
  fi
fi

# ─── One-time peer-egress policy explanation ────────────────────────────────
# Consent is one remembered global authorization to use another provider. This
# separate remembered choice decides whether eligible material is sent
# automatically or only when explicitly approved for peer egress.
# Explain both choices when a usable peer exists; first actual use still asks
# in its own turn if the key remains unset.
if [ "$("$SKILL_DIR/bin/pln-config" get peer_egress_nudge_shown 2>/dev/null)" != "true" ]; then
  set +e
  PEER_EGRESS_WHICH="$("$SKILL_DIR/bin/pln-peer" --which --host "$HOST" 2>/dev/null)"
  PEER_EGRESS_RC=$?
  set -e
  PEER_EGRESS_RUNG="$(printf '%s\n' "$PEER_EGRESS_WHICH" | sed -n 's/^RUNG=//p')"
  PEER_EGRESS_STATUS="$(printf '%s\n' "$PEER_EGRESS_WHICH" | sed -n 's/^STATUS=//p')"
  if [ "$PEER_EGRESS_RUNG" != "3" ] \
    && [ "$PEER_EGRESS_STATUS" != "declined" ] \
    && [ "$PEER_EGRESS_STATUS" != "suppressed" ]; then
    echo ""
    echo "Peer egress policy: both choices below are remembered; neither prompts before every send."
    echo "  Choose:"
    echo "  \"$SKILL_DIR/bin/pln-config\" set peer_egress consent"
    echo "    sends material not marked sensitive/local-only without asking again, or"
    echo "  \"$SKILL_DIR/bin/pln-config\" set peer_egress approved-only"
    echo "    sends only material explicitly approved for peer egress; other material stays local without prompting."
    "$SKILL_DIR/bin/pln-config" set peer_egress_nudge_shown true >/dev/null
  fi
fi
